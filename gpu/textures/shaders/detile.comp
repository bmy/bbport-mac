// bbport textures: converts a surface between the GPU's tiled layout and a linear one, one texel
// per invocation over all levels (TILER: linear to tiled, else tiled to linear). The addressing is
// that of AMD's addrlib for GCN: texels interleaved within 8x8 micro tiles, micro tiles spread
// over pipes and banks in macro tiles.
// Built per texel size (BITS_PER_PIXEL) and for macro tiled modes (IS_MACRO_TILED); the rest comes
// in specialization constants and the level table.
#version 450 core
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types : require

layout(local_size_x = 64) in;

layout(constant_id = 0) const uint SAMPLES = 1;
layout(constant_id = 1) const uint MICRO_MODE = 1; // display, thin, depth, rotated, thick
layout(constant_id = 2) const uint THICKNESS = 1;  // slices per micro tile
layout(constant_id = 3) const uint TILER = 0;
#if IS_MACRO_TILED
layout(constant_id = 4) const uint ARRAY_MODE = 0;
layout(constant_id = 5) const uint PIPE_CONFIG = 0;
layout(constant_id = 6) const uint BANK_WIDTH = 1;
layout(constant_id = 7) const uint BANK_HEIGHT = 1;
layout(constant_id = 8) const uint BANKS = 1;
layout(constant_id = 9) const uint BANK_BITS = 1;
layout(constant_id = 10) const uint TILE_SPLIT = 1; // bytes
layout(constant_id = 11) const uint ASPECT = 1;     // macro tile aspect
#endif

#if BITS_PER_PIXEL == 8
#define Texel uint8_t
#elif BITS_PER_PIXEL == 16
#define Texel uint16_t
#elif BITS_PER_PIXEL == 32
#define Texel uint32_t
#elif BITS_PER_PIXEL == 64
#define Texel u32vec2
#elif BITS_PER_PIXEL == 96
#define Texel u32vec3
#else
#define Texel u32vec4
#endif
const uint BYTES = BITS_PER_PIXEL / 8;

layout(set = 0, binding = 0, scalar) buffer Tiled { Texel tiled[]; };
layout(set = 0, binding = 1, scalar) buffer Linear { Texel linear[]; };

struct Level {
    uint size;   // bytes of all its slices
    uint pitch;  // texels (blocks)
    uint height;
    uint offset; // in the tiled surface
};
layout(set = 0, binding = 2, scalar) uniform Levels {
    uint bank_swizzle;
    uint micro_tiled_levels; // macro tiled surfaces: levels stored micro tiled (bits)
    uint num_levels;
    Level levels[16];
};

const uint DISPLAY = 0, THIN = 1, DEPTH = 2;
const uint TILE = 8; // micro tile side in texels
const uint PIPE_INTERLEAVE_BITS = 8;

uint Bit(uint value, uint bit) {
    return (value >> bit) & 1u;
}

/// The texel's index within its micro tile: bits of x, y and z interleaved in an order that
/// depends on the micro tile mode and the texel size.
uint IndexInMicroTile(uint x, uint y, uint z, uint thickness) {
    const uint x0 = Bit(x, 0), x1 = Bit(x, 1), x2 = Bit(x, 2);
    const uint y0 = Bit(y, 0), y1 = Bit(y, 1), y2 = Bit(y, 2);
    const uint z0 = Bit(z, 0), z1 = Bit(z, 1), z2 = Bit(z, 2);
    uint b[9] = {0, 0, 0, 0, 0, 0, 0, 0, 0};
    if (MICRO_MODE == DISPLAY) {
#if BITS_PER_PIXEL == 8
        b = uint[9](x0, x1, x2, y1, y0, y2, 0, 0, 0);
#elif BITS_PER_PIXEL == 16
        b = uint[9](x0, x1, x2, y0, y1, y2, 0, 0, 0);
#elif BITS_PER_PIXEL == 32
        b = uint[9](x0, x1, y0, x2, y1, y2, 0, 0, 0);
#elif BITS_PER_PIXEL == 64
        b = uint[9](x0, y0, x1, x2, y1, y2, 0, 0, 0);
#elif BITS_PER_PIXEL == 128
        b = uint[9](x0, y0, x1, y1, x2, y2, 0, 0, 0);
#endif
        // 96-bit texels have no display order: every one is index 0 (never used so).
    } else if (MICRO_MODE == THIN || MICRO_MODE == DEPTH) {
        b = uint[9](x0, y0, x1, y1, x2, y2, 0, 0, 0);
    } else {
        // Thick and rotated: z bits too.
#if BITS_PER_PIXEL == 8 || BITS_PER_PIXEL == 16
        b = uint[9](x0, y0, x1, y1, z0, z1, 0, 0, 0);
#elif BITS_PER_PIXEL == 32
        b = uint[9](x0, y0, x1, z0, y1, z1, 0, 0, 0);
#elif BITS_PER_PIXEL == 64 || BITS_PER_PIXEL == 128
        b = uint[9](x0, y0, z0, x1, y1, z1, 0, 0, 0);
#endif
        b[6] = x2;
        b[7] = y2;
        b[8] = thickness == 8 ? z2 : 0;
    }
    uint index = 0;
    for (uint i = 0; i < 9; ++i) {
        index |= b[i] << i;
    }
    return index;
}

/// The texel's byte offset within its micro tile (sample 0; depth tiles keep a texel's samples
/// together, others a sample's texels).
uint OffsetInMicroTile(uint x, uint y, uint z, uint thickness) {
    const uint index = IndexInMicroTile(x, y, z, thickness);
    return MICRO_MODE == DEPTH ? index * BITS_PER_PIXEL * SAMPLES / 8 : index * BITS_PER_PIXEL / 8;
}

uint MicroTiledOffset(uint x, uint y, uint z, uint pitch, uint height, uint thickness) {
    const uint tile_bytes = TILE * TILE * thickness * BITS_PER_PIXEL * SAMPLES / 8;
    const uint slice_bytes = (pitch * height * thickness * BITS_PER_PIXEL * SAMPLES + 7) / 8;
    const uint tile = (y / TILE) * (pitch / TILE) + x / TILE;
    return (z / thickness) * slice_bytes + tile * tile_bytes + OffsetInMicroTile(x, y, z, thickness);
}

#if IS_MACRO_TILED
const uint PIPES = PIPE_CONFIG == 0 ? 2 : 8;
const uint PIPE_BITS = PIPE_CONFIG == 0 ? 1 : 3;
const uint MICRO_TILE_BYTES = TILE * TILE * THICKNESS * BITS_PER_PIXEL * SAMPLES / 8;

bool Is3D() {
    return ARRAY_MODE == 12 || ARRAY_MODE == 13 || ARRAY_MODE == 14;
}
bool Is2D() {
    return ARRAY_MODE == 4 || ARRAY_MODE == 7 || ARRAY_MODE == 8;
}
bool IsPrt() {
    return ARRAY_MODE == 5 || ARRAY_MODE == 6 || ARRAY_MODE == 9 || ARRAY_MODE == 10 ||
           ARRAY_MODE == 11 || ARRAY_MODE == 15;
}
/// Thin 2D and 3D modes rotate banks per tile split slice.
bool RotatesSplits() {
    return ARRAY_MODE == 4 || ARRAY_MODE == 12 || ARRAY_MODE == 6 || ARRAY_MODE == 11;
}

/// The pipe a micro tile goes to: bits of its tile coordinates, by pipe configuration; 3D modes
/// rotate it per slice.
uint PipeOf(uint x, uint y, uint z) {
    const uint tx = x / TILE, ty = y / TILE;
    const uint x3 = Bit(tx, 0), x4 = Bit(tx, 1), x5 = Bit(tx, 2);
    const uint y3 = Bit(ty, 0), y4 = Bit(ty, 1), y5 = Bit(ty, 2);
    uint pipe = 0;
    if (PIPE_CONFIG == 0) { // P2
        pipe = x3 ^ y3;
    } else if (PIPE_CONFIG == 10) { // P8_32x32_8x16
        pipe = (x4 ^ y3 ^ x5) | (x3 ^ y4) << 1 | (x5 ^ y5) << 2;
    } else if (PIPE_CONFIG == 12) { // P8_32x32_16x16
        pipe = (x3 ^ y3 ^ x4) | (x4 ^ y4) << 1 | (x5 ^ y5) << 2;
    }
    uint swizzle = 0;
    if (Is3D()) {
        swizzle = max(1u, PIPES / 2 - 1) * (z / THICKNESS);
    }
    return pipe ^ (swizzle & (PIPES - 1));
}

/// The bank: bits of the tile coordinates within the pipes and bank rows, then rotations per
/// slice and tile split slice, and the surface's bank swizzle.
uint BankOf(uint x, uint y, uint z, uint split_slice) {
    const uint tx = x / TILE / (BANK_WIDTH * PIPES);
    const uint ty = y / TILE / BANK_HEIGHT;
    const uint x3 = Bit(tx, 0), x4 = Bit(tx, 1), x5 = Bit(tx, 2), x6 = Bit(tx, 3);
    const uint y3 = Bit(ty, 0), y4 = Bit(ty, 1), y5 = Bit(ty, 2), y6 = Bit(ty, 3);
    uint bank = 0;
    if (BANKS == 16) {
        bank = (x3 ^ y6) | (x4 ^ y5 ^ y6) << 1 | (x5 ^ y4) << 2 | (x6 ^ y3) << 3;
    } else if (BANKS == 8) {
        bank = (x3 ^ y5) | (x4 ^ y4 ^ y5) << 1 | (x5 ^ y3) << 2;
    } else if (BANKS == 4) {
        bank = (x3 ^ y4) | (x4 ^ y3) << 1;
    } else if (BANKS == 2) {
        bank = x3 ^ y3;
    }
    uint slice_rotation = 0;
    if (Is2D()) {
        slice_rotation = (BANKS / 2 - 1) * (z / THICKNESS);
    } else if (Is3D()) {
        slice_rotation = max(1u, PIPES / 2 - 1) * (z / THICKNESS) / PIPES;
    }
    const uint split_rotation = RotatesSplits() ? (BANKS / 2 + 1) * split_slice : 0;
    return ((bank ^ (bank_swizzle + slice_rotation)) ^ split_rotation) & (BANKS - 1);
}

uint MacroTiledOffset(uint x, uint y, uint z, uint pitch, uint height) {
    uint element = OffsetInMicroTile(x, y, z, THICKNESS);
    // A thin micro tile larger than the tile split is cut into slices of that size.
    uint tile_bytes = MICRO_TILE_BYTES;
    uint slices_per_tile = 1;
    uint split_slice = 0;
    if (MICRO_TILE_BYTES > TILE_SPLIT && THICKNESS == 1) {
        slices_per_tile = MICRO_TILE_BYTES / TILE_SPLIT;
        split_slice = element / TILE_SPLIT;
        element %= TILE_SPLIT;
        tile_bytes = TILE_SPLIT;
    }
    const uint macro_width = TILE * BANK_WIDTH * PIPES * ASPECT;
    const uint macro_height = TILE * BANK_HEIGHT * BANKS / ASPECT;
    const uint macro_bytes =
        tile_bytes * (macro_width / TILE) * (macro_height / TILE) / (PIPES * BANKS);
    const uint macros_per_row = pitch / macro_width;
    const uint macro = (y / macro_height) * macros_per_row + x / macro_width;
    const uint slice_bytes = macros_per_row * (height / macro_height) * macro_bytes;
    const uint slice = split_slice + slices_per_tile * (z / THICKNESS);
    // The micro tile's place within its bank.
    const uint row = (y / TILE) % BANK_HEIGHT;
    const uint column = (x / TILE / PIPES) % BANK_WIDTH;
    const uint offset = slice * slice_bytes + macro * macro_bytes + element +
                        (row * BANK_WIDTH + column) * tile_bytes;

    // Partially resident modes address within one macro tile.
    if (IsPrt()) {
        x %= macro_width;
        y %= macro_height;
    }
    const uint pipe = PipeOf(x, y, z);
    const uint bank = BankOf(x, y, z, split_slice);
    // Address bits: [pipe interleave][pipe][bank][rest].
    const uint interleave = offset & ((1u << PIPE_INTERLEAVE_BITS) - 1);
    const uint rest = offset >> PIPE_INTERLEAVE_BITS;
    return interleave | pipe << PIPE_INTERLEAVE_BITS | bank << (PIPE_INTERLEAVE_BITS + PIPE_BITS) |
           rest << (PIPE_INTERLEAVE_BITS + PIPE_BITS + BANK_BITS);
}
#endif

void main() {
    // The level of this texel (texels of all levels follow each other in the linear surface).
    uint texel = gl_GlobalInvocationID.x;
    uint level = 0;
    while (level < num_levels && texel >= levels[level].size / BYTES) {
        texel -= levels[level].size / BYTES;
        ++level;
    }
    const uint pitch = levels[level].pitch;
    const uint height = levels[level].height;
    const uint x = texel % pitch;
    const uint y = (texel / pitch) % height;
    const uint z = texel / (pitch * height);

    uint offset = levels[level].offset;
#if IS_MACRO_TILED
    if ((micro_tiled_levels & (1u << level)) != 0) {
        offset += MicroTiledOffset(x, y, z, pitch, height, min(THICKNESS, 4u));
    } else {
        offset += MacroTiledOffset(x, y, z, pitch, height);
    }
#else
    offset += MicroTiledOffset(x, y, z, pitch, height, THICKNESS);
#endif
    if (TILER != 0) {
        tiled[offset / BYTES] = linear[gl_GlobalInvocationID.x];
    } else {
        linear[gl_GlobalInvocationID.x] = tiled[offset / BYTES];
    }
}
