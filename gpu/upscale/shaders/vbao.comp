// bbport: GT-VBAO, ground-truth ambient occlusion with a visibility bitmask (O. Therrien,
// Y. Levesque, G. Gilet, "Screen Space Indirect Lighting with Visibility Bitmask", 2023). Each
// slice keeps 32 angular sectors of the hemisphere around the projected normal; a depth sample
// occludes only the sectors between its front face and its back face (the depth plus an assumed
// thickness), so thin objects in front of distant geometry do not darken it (no halos).
// Writes the raw AO (1 = unoccluded) and the view depth into a scratch RG16F image; vbao_blur.comp
// denoises it into the game's AO target (vk_vbao.h).
#version 450
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform texture2D depth_tex; // D32, depth 0..1 (D3D projection)
layout(binding = 1, rgba16f) uniform writeonly image2D raw_img; // AO, view z, normal xy
layout(binding = 2) uniform texture2D normal_tex; // the G-buffer's world normals, unorm xyz

layout(push_constant) uniform Constants {
    vec4 view_rows[3]; // world to view rotation, rows
    vec4 proj; // x scale, y scale, z scale, z offset; ndc +y down the screen
    vec2 size; // output pixels
    vec2 normal_scale; // normal texels per output pixel
    float depth_scale; // depth pixels per output pixel (1, or 2 for the half-size target)
    float radius;
    float thickness;
    float intensity;
    float max_radius_px;
    uint frame;
    uint normal_mode; // 0: normals from depth; 1: G-buffer normals (world, through view_rows)
};

const float PI = 3.14159265;
const float HALF_PI = 1.57079633;
const uint SECTORS = 32u;
const int SLICES = 3;
const int STEPS = 8; // per side

// View position (+z away from the camera) of a pixel position at view depth z.
vec3 ViewAt(vec2 pixel, float z) {
    const vec2 ndc = pixel / size * 2.0 - 1.0;
    return vec3(ndc.x * z / proj.x, ndc.y * z / proj.y, z);
}

float ViewZ(float depth) {
    // Clip z = zs * z + zo, w = z; depth = zs + zo / z (see camera_motion.comp).
    return proj.w / min(depth - proj.z, -1e-8);
}

float DepthAt(ivec2 pixel) {
    pixel = clamp(pixel, ivec2(0), ivec2(size) - 1);
    return texelFetch(depth_tex, ivec2((vec2(pixel) + 0.5) * depth_scale), 0).r;
}

vec3 ViewPos(ivec2 pixel) {
    return ViewAt(vec2(pixel) + 0.5, ViewZ(DepthAt(pixel)));
}

// The blur's guides: view depth and the normal (xy; z faces the camera).
void Store(ivec2 pixel, float visibility, float z, vec3 normal) {
    imageStore(raw_img, pixel, vec4(visibility, min(z, 65000.0), normal.xy));
}

float FastAcos(float x) {
    const float a = abs(x);
    const float r = (-0.156583 * a + HALF_PI) * sqrt(1.0 - a);
    return x >= 0.0 ? r : PI - r;
}

// Interleaved gradient noise (Jimenez 2014), shifted per frame for temporal accumulation.
float Noise(vec2 pixel) {
    pixel += 5.588238 * float(frame & 63u);
    return fract(52.9829189 * fract(dot(pixel, vec2(0.06711056, 0.00583715))));
}

uint Sectors(float min_t, float max_t) {
    min_t = clamp(min_t, 0.0, 1.0);
    max_t = clamp(max_t, 0.0, 1.0);
    const uint start = uint(min_t * float(SECTORS));
    const uint count = uint(ceil((max_t - min_t) * float(SECTORS)));
    if (count == 0u || start >= SECTORS) {
        return 0u;
    }
    const uint bits = count >= SECTORS ? 0xffffffffu : ((1u << count) - 1u);
    return bits << start;
}

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(size.x) || pixel.y >= int(size.y)) {
        return;
    }
    const float depth = DepthAt(pixel);
    if (depth >= 1.0) {
        Store(pixel, 1.0, 65000.0, vec3(0.0));
        return;
    }
    const vec3 pos = ViewAt(vec2(pixel) + 0.5, ViewZ(depth));
    const vec3 view_dir = normalize(-pos);

    // Normal from depth: of the two neighbours on each axis, the one on the same surface.
    const vec3 px0 = ViewPos(pixel - ivec2(1, 0)), px1 = ViewPos(pixel + ivec2(1, 0));
    const vec3 py0 = ViewPos(pixel - ivec2(0, 1)), py1 = ViewPos(pixel + ivec2(0, 1));
    const vec3 dx = abs(px1.z - pos.z) < abs(pos.z - px0.z) ? px1 - pos : pos - px0;
    const vec3 dy = abs(py1.z - pos.z) < abs(pos.z - py0.z) ? py1 - pos : pos - py0;
    vec3 normal = normalize(cross(dy, dx));
    if (dot(normal, view_dir) < 0.0) {
        normal = -normal;
    }
    // The G-buffer normal carries the normal maps (mortar, carvings): the detail the game's SSAO
    // has and depth alone does not. Kept where it agrees with the surface: it may be another
    // layer's at an edge (the AO is at half size) or face away (alpha-tested foliage).
    if (normal_mode != 0u) {
        const ivec2 texel = ivec2((vec2(pixel) + 0.5) * normal_scale);
        const vec3 world = texelFetch(normal_tex, texel, 0).xyz * 2.0 - 1.0;
        if (dot(world, world) > 0.25) {
            vec3 detail = normalize(vec3(dot(view_rows[0].xyz, world), dot(view_rows[1].xyz, world),
                                         dot(view_rows[2].xyz, world)));
            if (dot(detail, view_dir) < 0.0 && dot(detail, normal) < 0.0) {
                detail = -detail; // a two-sided surface seen from behind
            }
            if (dot(detail, normal) > 0.25) {
                normal = detail;
            }
        }
    }

    // World radius on the screen, in pixels.
    const float radius_px = min(radius * abs(proj.x) * 0.5 * size.x / pos.z, max_radius_px);
    if (radius_px < 1.0) {
        Store(pixel, 1.0, pos.z, normal);
        return;
    }
    const float noise = Noise(vec2(pixel));
    const float step_noise = fract(noise + 0.618034 * float(frame & 7u));

    float visibility = 0.0;
    float weight = 0.0;
    for (int slice = 0; slice < SLICES; ++slice) {
        const float phi = (float(slice) + noise) * PI / float(SLICES);
        const vec2 omega = vec2(cos(phi), sin(phi));
        // The slice plane: the view direction and the screen direction omega.
        const vec3 direction = normalize(ViewAt(vec2(pixel) + 0.5 + omega, pos.z) - pos);
        const vec3 ortho = normalize(direction - dot(direction, view_dir) * view_dir);
        const vec3 axis = cross(ortho, view_dir);
        const vec3 proj_normal = normal - axis * dot(normal, axis);
        const float proj_length = length(proj_normal);
        if (proj_length < 1e-4) {
            continue;
        }
        // Angles in the slice from the view direction, positive towards `ortho`.
        const float n = sign(dot(ortho, proj_normal)) *
                        FastAcos(clamp(dot(proj_normal, view_dir) / proj_length, -1.0, 1.0));
        uint occluded = 0u;
        for (int side = 0; side < 2; ++side) {
            const float s = side == 0 ? 1.0 : -1.0;
            for (int i = 0; i < STEPS; ++i) {
                // Quadratic spacing: more samples close to the pixel.
                float t = (float(i) + step_noise) / float(STEPS);
                t = t * t;
                const vec2 offset = s * omega * max(t * radius_px, float(i + 1));
                const ivec2 sample_pixel = ivec2(vec2(pixel) + 0.5 + offset);
                if (any(lessThan(sample_pixel, ivec2(0))) ||
                    any(greaterThanEqual(sample_pixel, ivec2(size)))) {
                    break;
                }
                const vec3 delta = ViewPos(sample_pixel) - pos;
                const float len = length(delta);
                if (len < 1e-4) {
                    continue;
                }
                const vec3 back = delta - view_dir * thickness;
                float front_angle = s * FastAcos(clamp(dot(delta / len, view_dir), -1.0, 1.0));
                float back_angle = s * FastAcos(clamp(dot(normalize(back), view_dir), -1.0, 1.0));
                // Hemisphere around the projected normal: [n - pi/2, n + pi/2] -> [0, 1].
                const float a = (min(front_angle, back_angle) - n + HALF_PI) / PI;
                const float b = (max(front_angle, back_angle) - n + HALF_PI) / PI;
                occluded |= Sectors(a, b);
            }
        }
        visibility += proj_length * (1.0 - float(bitCount(occluded)) / float(SECTORS));
        weight += proj_length;
    }
    float ao = weight > 0.0 ? visibility / weight : 1.0;
    Store(pixel, pow(clamp(ao, 0.0, 1.0), intensity), pos.z, normal);
}
