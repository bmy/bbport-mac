@@ -433,6 +433,10 @@ uint32_t findMemoryTypeIndex(
     vkGetPhysicalDeviceMemoryProperties(physicalDevice, &memProperties);
 
     uint32_t bestCandidate = UINT32_MAX;
+    // bbport: unified-memory devices (Apple Silicon via KosmicKrisp/MoltenVK) have only
+    // DEVICE_LOCAL|HOST_VISIBLE types; when nothing better exists, use one of them.
+    uint32_t hostVisibleLocalFallback = UINT32_MAX;
+    VkMemoryPropertyFlags fallbackProperties = 0;
 
     for (uint32_t i = 0; i < memProperties.memoryTypeCount; i++) {
