+         (uint64_t)poly_tcs_in_size(count * instance_count, vertex_outputs) + 16;
+      if ((uint64_t)p->heap->bottom + need_B >= (uint64_t)p->heap->size) {
+         p->patches_per_instance = 0;
+         p->nr_patches = 0;
