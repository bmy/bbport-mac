BB_ENV(BB_FSR4CAP_CLEAN, INTERNAL, "=1: the FSR 4.1.1 build removes its work folder afterwards (set by the launcher)")
BB_ENV(BB_FSR4CAP_TOOLS, INTERNAL, "the FSR 4.1.1 build's tools folder (set by the launcher)")
BB_ENV(BB_FSR4CAP_WORK, INTERNAL, "the FSR 4.1.1 build's work folder (set by the launcher)")
BB_ENV(BB_GPU_DEPS, INTERNAL, "(macOS) the native GPU process's library folder (default deps-arm64 beside bb-probe's folder)")
BB_ENV(BB_GPU_PROCESS, INTERNAL, "(macOS) the native GPU process to start (default gpu-arm64/bb-gpu in bb-probe's folder)")
BB_ENV(BB_GPU_USER_DIR, INTERNAL, "the user folder as the GPU library and the online module see it (set by the runtime)")
BB_ENV(BB_IMAGE_SHAPES, INTERNAL, "the package's image shapes list for spare images (set by run.py)")
BB_ENV(BB_INTERNAL_HEIGHT, INTERNAL, "the game's internal screen height (default 1080; set by run.py)")
BB_ENV(BB_INTERNAL_WIDTH, INTERNAL, "the game's internal screen width (default 1920; set by run.py)")
BB_ENV(BB_LAUNCHER_SECTION, INTERNAL, "the launcher page to open")
BB_ENV(BB_LIVE_RES, INTERNAL, "=1: render resolution changes live (set by run.py)")
BB_ENV(BB_MODS_CONFIG, INTERNAL, "the mods list (default <data>/mods.json)")
BB_ENV(BB_MODS_DIR, INTERNAL, "the folder of enabled mods' files (set by run.py)")
BB_ENV(BB_MONITOR_SIZE, INTERNAL, "=WxH: the monitor's size the startup patch was made for (set by the launcher)")
BB_ENV(BB_OUTPUT_RES, INTERNAL, "=WxH: the output the startup patch was made for (set by run.py)")
BB_ENV(BB_PATCHES_CONFIG, INTERNAL, "the patch choice file (default <data>/patches.json)")
BB_ENV(BB_PATCHES_DIR, INTERNAL, "the patches folder (default <data>/patches)")
BB_ENV(BB_PREBUILT, INTERNAL, "=1: packaged build, run.sh builds nothing (set by the AppImage)")
BB_ENV(BB_PROBE, INTERNAL, "path of bb-probe for run.py")
BB_ENV(BB_SHADER_GAME_DIR, INTERNAL, "the game's files the shader recipes' programs come from (set by run.py)")
BB_ENV(BB_SHADER_RECIPES, INTERNAL, "the shader recipes pack (set by run.py)")
BB_ENV(BB_SKIP_NETWORK_CHOICE, INTERNAL, "=1: no online choice at start (the launcher's)")
BB_ENV(BB_STALL_THREADS_DONE, INTERNAL, "set by the port once all threads were reported")
BB_ENV(BB_STEAM_OVERLAY, INTERNAL, "the Steam overlay's preload kept for the game (=0: off; set by the AppImage entry)")
BB_ENV(BB_TIMEOUT, INTERNAL, "=seconds: run.py stops the game after this long (tests)")
BB_ENV(BB_USER_DIR, INTERNAL, "the user folder (saves, settings; set by run.py)")
BB_ENV(BB_VBLANK_HZ, INTERNAL, "=N (default 60, 0: 480): the guest vblank rate (1000 for uncapped; set by run.py)")
BB_ENV(BB_VULKAN_LIBRARY, INTERNAL, "the Vulkan loader by path (macOS: the app's own copy, as the default search tries leaf names only)")

// Build and packaging scripts (the game never reads these).
BB_ENV(BB_APP, BUILD, "macOS: where tools/macos/build_launcher.sh puts the app (default out/bbport.app)")
BB_ENV(BB_ARCH, BUILD, "=x86_64 (default) / arm64: the architecture tools/macos/setup_deps.sh builds for (arm64: the native GPU process's libraries)")
BB_ENV(BB_CCACHE, BUILD, "=0: the macOS build scripts without ccache")
BB_ENV(BB_DEPS, BUILD, "macOS: the x86-64 dependency prefix (default deps-x86_64)")
BB_ENV(BB_DEPS_ARM64, BUILD, "macOS: the arm64 dependency prefix the native GPU process builds with (default deps-arm64)")
BB_ENV(BB_FSR4CAP_CHECKED, BUILD, "internal to tools/fsr4cap: the tools were checked")
BB_ENV(BB_FSR4CAP_FP8, BUILD, "=1: also the FP8 FSR 4.1.1 variant through Proton's emulation; 0: never")
BB_ENV(BB_FSR4CAP_ON_HOST, BUILD, "set: the FSR 4.1.1 capture runs without systemd-run")
BB_ENV(BB_FSR4CAP_RUNNER, BUILD, "=steam: the FSR 4.1.1 capture uses Steam's runtime")
BB_ENV(BB_FSR4CAP_SHELL, BUILD, "internal to tools/fsr4cap: already inside the nix shell with the tools")
BB_ENV(BB_FSR4CAP_SPOOF, BUILD, "=0: the FSR 4.1.1 capture does not present an RDNA4 GPU to AMD's DLL")
BB_ENV(BB_FSR4CAP_UMU_SHELL, BUILD, "internal to tools/fsr4cap: already inside the umu nix shell")
BB_ENV(BB_FSR4_DRIVER_MODELS, BUILD, "FSR 4 driver models to build (default: navi2 lite)")
BB_ENV(BB_FSR4_TIERS, BUILD, "FSR 4 v07 asset tiers to download (tools/fetch_fsr4_assets.sh)")
BB_ENV(BB_IN_NIX_SHELL, BUILD, "internal to run.sh: already inside the nix shell")
BB_ENV(BB_LTO, BUILD, "=1: link-time optimization (packaging)")
BB_ENV(BB_NET, BUILD, "=OFF: no online module (shadNet) in the build (CMake option)")
BB_ENV(BB_PACKAGE_FSR411, BUILD, "=1: the AppImage carries FSR 4.1.1 models (never in public packages)")
BB_ENV(BB_PGO, BUILD, "=generate / use: profile-guided optimization (CMake option)")
BB_ENV(BB_PGO_DIR, BUILD, "the PGO profile folder (CMake option)")
BB_ENV(BB_REBUILD, BUILD, "=1: tools/macos/update.sh builds everything again")
BB_ENV(BB_RELEASE, BUILD, "=version: tools/macos/build_launcher.sh makes a release app (no repository path, no game icon)")
BB_ENV(BB_SKIP_GPU, BUILD, "set: tools/macos/build.sh builds the loader only (the GPU library already built)")
BB_ENV(BB_VERSION, BUILD, "the version tools/macos/package.sh packages (unless given as its first argument)")
