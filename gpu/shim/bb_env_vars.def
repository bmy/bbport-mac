// bbport: every environment variable the port reads (BB_*), with what it does: one
//     BB_ENV(NAME, KIND, "what it does")
// per variable, by kind and name. The C/C++ code reads them through bb_env.h; scripts/env_vars.py
// makes docs/ENVIRONMENT.md from this list and tests/test_env_vars.py checks it against the code
// (a variable read but not listed, or listed but read nowhere, fails it). The game prints the ones
// set at start and names any other BB_* in its environment (a typo).
//
// "=1: ...", "=0: ...", "=N: ...": what that value does; "set: ..." any value at all (even 0).

// Settings: what players and the launchers set (the menu, bbport.ini and the launcher write most of them).
BB_ENV(BB_ANISO, SETTING, "=N: anisotropic filtering of scene textures (default 16)")
BB_ENV(BB_ASYNC_PIPELINES, SETTING, "=0: new pipelines of passes drawn every frame compiled at once instead of skipping a draw for a frame or two")
BB_ENV(BB_AUTO_RENDER_RES, SETTING, "=1: render resolution picked from the measured frame rate")
BB_ENV(BB_BBSC, SETTING, "=1: seamless co-op (BBSC), the launcher's co-op switch")
BB_ENV(BB_BBSC_LOCAL_SERVER, SETTING, "=1 / auto (default) / 0: the BBSC game server on this PC (scripts/bbsc_gameserver)")
BB_ENV(BB_BUTTON_PROMPTS, SETTING, "=0: the game's PlayStation button icons always")
BB_ENV(BB_COMMUNITY_SERVER, SETTING, "URL of the online pool server (default: the community server)")
BB_ENV(BB_CONFIG, SETTING, "=path: the controls file (default bbport.ini)")
BB_ENV(BB_CONTENT_SKU, SETTING, "=full / ...: the content profile run.py prepares")
BB_ENV(BB_CURSOR, SETTING, "=0: the system's mouse cursor instead of the port's")
BB_ENV(BB_DECK_DESKTOP_INPUT, SETTING, "=1: keep keyboard and mouse on a Steam Deck in game mode")
BB_ENV(BB_DISPLAY, SETTING, "=N: the monitor to open the window on")
BB_ENV(BB_DLSS, SETTING, "=0: no DLSS even on NVIDIA RTX")
BB_ENV(BB_DMEM_EXTRA_MB, SETTING, "=N (0-2048, default 512): direct memory beyond the PS4's for the port's extras")
BB_ENV(BB_DMEM_MB, SETTING, "=N: the game's direct memory size in MiB (PS4: 5056; raised for high resolutions and large heaps)")
BB_ENV(BB_EVDEV_TOUCHPAD, SETTING, "=0: no DualSense/DualShock touchpad through evdev")
BB_ENV(BB_FPS, SETTING, "=uncap (default) / 90 / 60 / 30: the frame rate (the launcher's)")
BB_ENV(BB_FPS_LIMIT, SETTING, "=N: frame rate limit (the launcher's)")
BB_ENV(BB_FRAME_GEN, SETTING, "=fsr3 / dlss / fsr_amd (1: fsr3): frame generation")
BB_ENV(BB_FRAME_GEN_MULTIPLIER, SETTING, "=2..4: frames shown per rendered one with frame generation")
BB_ENV(BB_FRAME_STATS, SETTING, "set: frame statistics in the log every 5 s and slow frames (the launcher's statistics switch)")
BB_ENV(BB_FFX_DIR, SETTING, "the folder with AMD's FSR DLLs for Vulkan, amd_fidelityfx_loader_vk.dll and amd_fidelityfx_upscaler_vk.dll (upscaler fsr_amd; default <user>/fsr, then beside the game)")
BB_ENV(BB_FFX_FG_VERSION, SETTING, "=<part of a name>: the frame generation AMD's DLL runs, from those the log lists (default: theirs)")
BB_ENV(BB_FFX_FG_ML, SETTING, "=1: AMD's ML frame generation (4.0.x) accepts any GPU (AMD ships it for RDNA4); =0: refuses it (FSR 3.1)")
BB_ENV(BB_FFX_FG_DEBUG, DEBUG, "=1: AMD's frame generation draws its tear lines and reset marks")
BB_ENV(BB_FFX_VERSION, SETTING, "=<part of a name>: the upscaler AMD's FSR DLLs run, from those the log lists (default: theirs)")
BB_ENV(BB_FSR411_DIR, SETTING, "the FSR 4.1.1 assets folder (default fsr4_411)")
BB_ENV(BB_FSR411_VARIANT, SETTING, "=int8 / fp8 / fp8emu / navi2 / lite: FSR 4.1.1 model variant (default: the menu's model)")
BB_ENV(BB_FSR4_DIR, SETTING, "the FSR 4 v07 assets folder (default fsr4_shaders)")
BB_ENV(BB_FSR_SHARPNESS, SETTING, "=0..1: RCAS sharpening (the menu's)")
BB_ENV(BB_FULLSCREEN, SETTING, "=0 / 1 / exclusive: window mode")
BB_ENV(BB_GAMEPAD, SETTING, "=SDL GUID or part of the name: the controller to use (the launcher's)")
BB_ENV(BB_GAME_DIR, SETTING, "the game's folder (with eboot.bin)")
BB_ENV(BB_GAME_MENU, SETTING, "=0: no port pages in the game's System menu")
BB_ENV(BB_GPU_ID, SETTING, "=N: the GPU to use, by Vulkan index (the launcher's)")
BB_ENV(BB_GPU_PROFILE, SETTING, "=1: GPU profiler: time per labelled pass in the log (the launcher's)")
BB_ENV(BB_HDR, SETTING, "=1: HDR output allowed")
BB_ENV(BB_HUD_ANCHOR, SETTING, "=0: on wide screens the HUD stays in the 16:9 middle")
BB_ENV(BB_INTEL_TONEMAP_FIX, SETTING, "=0 / 1: Intel CPU tone mapping fix patch off / on (default on on Intel)")
BB_ENV(BB_JITTER, SETTING, "=0 / 1: upscaler camera jitter (the menu's)")
BB_ENV(BB_JUMP_GAP_MS, SETTING, "=N (default 70): pause around a keyboard jump while running")
BB_ENV(BB_JUMP_TAP_MS, SETTING, "=N (default 70): press length of a keyboard jump while running")
BB_ENV(BB_KEY_FALL_MS, SETTING, "=N (default 45): keyboard stick release time")
BB_ENV(BB_KEY_RISE_MS, SETTING, "=N (default 70): keyboard stick rise time")
BB_ENV(BB_KEY_TURN_DPS, SETTING, "=N (default 1100): keyboard stick turn speed in degrees a second")
BB_ENV(BB_LANGUAGE, SETTING, "=N: the game's language, PS4 number (1 English, 8 Russian; the launcher's)")
BB_ENV(BB_LARGE_HEAPS, SETTING, "=1 / 0: larger graphics heaps for texture packs on / off (default: detected)")
BB_ENV(BB_LAYER_MEMORY, SETTING, "=1 / 0: the layer's memory module (default on non-AMD GPUs)")
BB_ENV(BB_LOW_LATENCY, SETTING, "=off / on / boost: NVIDIA Reflex / AMD Anti-Lag (the menu's)")
BB_ENV(BB_MENU_LANGUAGE, SETTING, "=ru / en / ...: the port's menu language (default: the launcher's, else the system's)")
BB_ENV(BB_MENU_POINTER, SETTING, "=0: no mouse pointer in the game's menus")
BB_ENV(BB_MODS_ENABLED, SETTING, "=0: no mods")
BB_ENV(BB_MOUSE_AUTO_ROTATE, SETTING, "=1: the game's camera auto rotation also with the mouse")
BB_ENV(BB_MOUSE_DEADZONE, SETTING, "=N (default 16 of 127): mouse look dead zone")
BB_ENV(BB_NATIVE_GPU, SETTING, "=0 (macOS): the GPU work in the game process instead of the native GPU process bb-gpu (the default where bb-gpu is built); =1: bb-gpu or nothing")
BB_ENV(BB_NATIVE_MOUSE, SETTING, "=0: mouse look through the right stick instead of the camera hook")
BB_ENV(BB_NET_BACKEND, SETTING, "=thd: The Hunter's Dream online pool (the launcher's online pool)")
BB_ENV(BB_OBJECT_MOTION, SETTING, "=0 / 1: motion vectors of moving objects (the menu's)")
BB_ENV(BB_ONLINE, SETTING, "=1: online play (the launcher's)")
BB_ENV(BB_P2P_PORT, SETTING, "=N: the UDP port for P2P online traffic (default 3658, 0: any)")
BB_ENV(BB_PAD_DEADZONE, SETTING, "=N (default 5): stick inner dead zone")
BB_ENV(BB_PAD_DEADZONE_OUTER, SETTING, "=N (default 127): stick outer limit")
BB_ENV(BB_PAD_MOTION, SETTING, "=0 / 1: motion sensor emulation (over bbport.ini pad_motion)")
BB_ENV(BB_PATCHES, SETTING, "=name,...: extra patches by name (patches.py)")
BB_ENV(BB_PROCESS_PRIORITY, SETTING, "=normal / above / high: process priority on Windows (default above)")
BB_ENV(BB_REACTIVE, SETTING, "=1: FSR reactive mask (the menu's)")
BB_ENV(BB_REACTIVE_MAX, SETTING, "reactive mask maximum (the menu's)")
BB_ENV(BB_REACTIVE_SCALE, SETTING, "reactive mask scale (the menu's)")
BB_ENV(BB_REACTIVE_THRESHOLD, SETTING, "reactive mask threshold (the menu's)")
BB_ENV(BB_RENDER_RES, SETTING, "=WxH: render resolution through the startup patch (compatibility)")
BB_ENV(BB_SAVE_LOG, SETTING, "=1: the log and frame statistics also kept in logs/")
BB_ENV(BB_SHADER_PROGRESS, SETTING, "=0: no shader compilation progress on screen")
BB_ENV(BB_SHADNET_NPID, SETTING, "the shadNet account name (the launcher's)")
BB_ENV(BB_SHADNET_PASSWORD, SETTING, "the shadNet account password (the launcher's)")
BB_ENV(BB_SHADNET_SERVER, SETTING, "the shadNet server")
BB_ENV(BB_SHADNET_TOKEN, SETTING, "the shadNet account token (the launcher's)")
BB_ENV(BB_SHADNET_WEBAPI, SETTING, "the shadNet web API server")
BB_ENV(BB_SHOW_FPS, SETTING, "=1 / 0: the FPS counter on / off (show_fps)")
BB_ENV(BB_SKIP_CPU_CHECK, SETTING, "=1: skip the check of the CPU's bsr/bsf behaviour before the game starts")
BB_ENV(BB_SKIP_GAME_CHECK, SETTING, "=1: start with game files that did not pass the check")
BB_ENV(BB_TEXTURE_QUALITY, SETTING, "texture quality over bbport.ini's texture_quality")
BB_ENV(BB_THD_ONLINE_ID, SETTING, "The Hunter's Dream online name (the launcher's)")
BB_ENV(BB_THD_TOKEN, SETTING, "The Hunter's Dream account token (the launcher's)")
BB_ENV(BB_TROPHY_KEY, SETTING, "the trophy data key (from the environment or the port's .env)")
BB_ENV(BB_UPNP, SETTING, "=1: UPnP port forwarding for online play")
BB_ENV(BB_UPSCALER, SETTING, "=none / fsr3 / fsr4 / dlss / ...: the upscaler over the menu's (scripts, A/B)")
BB_ENV(BB_UPSCALE_PRESET, SETTING, "the upscaler quality preset (the menu's)")
BB_ENV(BB_USER_NAME, SETTING, "the PS4 user name (default Hunter)")

// Tuning: defaults to change on a machine where they misbehave, workarounds, A/B switches of fixes.
BB_ENV(BB_ADB, TUNING, "path of adb for BB_APP0_ADB (default: adb)")
BB_ENV(BB_ANTI_LAG, TUNING, "=1: AMD Anti-Lag 2 through Mesa's layer (measured ~0 gain, #289)")
BB_ENV(BB_APP0_ADB, TUNING, "=serial: the game's files fetched from a phone over adb on first open")
BB_ENV(BB_ASYNC_PIPELINE_THREADS, TUNING, "=N: threads compiling pipelines in the background")
BB_ENV(BB_ASYNC_SUBMIT, TUNING, "=0: the presenter submits the frame itself instead of a submit thread")
BB_ENV(BB_AUDIO, TUNING, "=none: no audio device (headless runs)")
BB_ENV(BB_AUTO_NOHIZ, TUNING, "=0 (run.sh): no automatic RADV_DEBUG=nohiz on the GPUs that need it")
BB_ENV(BB_AVPLAYER_ASYNC_READY, TUNING, "=1: movie StateReady on the controller thread, as before (crashed at 200+ FPS)")
BB_ENV(BB_BDA_DEDICATED_MB, TUNING, "=N: buffers with GPU addresses get dedicated memory from N MiB")
BB_ENV(BB_BIND_MEMO, TUNING, "=0: every resource binding takes the full path (no memo)")
BB_ENV(BB_BREADCRUMBS, TUNING, "=0: no GPU breadcrumbs (what the GPU was drawing at a hang)")
BB_ENV(BB_CHUNK_TEXTURES, TUNING, "=0: texture data copied instead of read in place from guest memory chunks")
BB_ENV(BB_CHUNK_UPLOADS, TUNING, "=0: uploads through CPU staging instead of binding guest memory in place")
BB_ENV(BB_COMMIT_IMPORT_LOCKED, TUNING, "=1: guest memory commits import under the lock")
BB_ENV(BB_COMPUTE_RELEASE_FLUSH, TUNING, "=0: work before a compute release waits for the rest of the frame")
BB_ENV(BB_CONSTANTS_IN_PLACE, TUNING, "=1: shader constants bound in place from guest memory instead of copied")
BB_ENV(BB_CONSTANT_RING_MB, TUNING, "=N: size of the constant ring in MiB")
BB_ENV(BB_CONSTRAM_GPU_WAIT, TUNING, "=0: a constant RAM dump does not wait for queued draws reading it (DoF artifacts #44)")
BB_ENV(BB_CONSTRAM_PIPE, TUNING, "=0: a constant RAM dump waits for all queued draws")
BB_ENV(BB_COPY_DEST_GAP, TUNING, "=bytes: merge gap of copy shader destinations (default 256)")
BB_ENV(BB_COPY_DEST_PRECISE, TUNING, "=0: the whole bound destination of a copy shader counts as written")
BB_ENV(BB_COPY_GPU_BUFFERS, TUNING, "=0: command buffers decoded from guest memory instead of a copy per submission")
BB_ENV(BB_COPY_MERGE_KB, TUNING, "=N: copy shader ranges closer than N KiB merged (default 64)")
BB_ENV(BB_COPY_PAGED_RANGES, TUNING, "=0: copy shader ranges whole instead of by page")
BB_ENV(BB_COPY_SHADER_NATIVE, TUNING, "=0: the copy shader's list read on the CPU")
BB_ENV(BB_COPY_THREADS, TUNING, "=N (0-16): threads for large guest memory copies")
BB_ENV(BB_CORE_RESERVE, TUNING, "=0 / 1: keep the game's threads off a reserved core (Linux, SMT CPUs with 6+ cores)")
BB_ENV(BB_CP_WAIT_SPIN_US, TUNING, "=N: microseconds the command thread spins while every queue waits, then it sleeps between checks (default 100 on arm64 macOS; -1, the default elsewhere: it spins until the wait ends)")
BB_ENV(BB_DEAD_IMAGES, TUNING, "=0: images of freed memory left to the collector instead of dropped on the GPU thread")
BB_ENV(BB_DEAD_IMAGES_LATE, TUNING, "set: dead images dropped at the frame's end only, as before")
BB_ENV(BB_DETILE_SKIPPED, TUNING, "=1: texture levels the quality setting leaves out are still detiled and read")
BB_ENV(BB_DIRECT_IMPORT_LOCKED, TUNING, "=1: direct memory imports under the lock")
BB_ENV(BB_DIRECT_MEMORY_ACCESS, TUNING, "=1: shadPS4's direct memory access mode of the shader translator")
BB_ENV(BB_DIRECT_SEGMENT, TUNING, "=0: the presenter waits for the recording threads instead of taking its own command segment")
BB_ENV(BB_DISABLE_HTTPS, TUNING, "=1: the game's HTTPS requests go out as plain HTTP (online)")
BB_ENV(BB_DRAIN_SPIN_US, TUNING, "=N: microseconds the draw pipe's stage A spins in a drain before it sleeps (default 50 on macOS; -1, the default elsewhere: it spins, then yields)")
BB_ENV(BB_DRAW_PIPE, TUNING, "=0 / N: the draw pipeline off, or its depth")
BB_ENV(BB_FAST_WRITER_FAULTS, TUNING, "=1: fast path for guest write faults (off: a device loss on a GTX 1050)")
BB_ENV(BB_FAULT_WINDOW, TUNING, "=KiB: window unprotected around a guest write fault (default 256)")
BB_ENV(BB_FFX_OWN_SHADERS, TUNING, "=0: FSR frame generation with the packaged shaders instead of the port's own")
BB_ENV(BB_FG_ASYNC, TUNING, "=1: FSR 3.1 frame generation on a second compute queue (no gain measured)")
BB_ENV(BB_FG_EARLY_RETIRE, TUNING, "=0: with frame generation the frame counts as finished only after it")
BB_ENV(BB_FIXED_ARENA, TUNING, "=1 / 0: force the fixed arena on or off (tests)")
BB_ENV(BB_FIX_CHARA_ID, TUNING, "=0: without the character id guard fix")
BB_ENV(BB_FIX_HIT_COLLECTOR, TUNING, "=0: without the hit collector overflow fix")
BB_ENV(BB_FIX_PLAY_TIME, TUNING, "=0: without the play time fix at high frame rates")
BB_ENV(BB_FLIP_AHEAD, TUNING, "=N (default 1, 0 off): the buffer shown before a flip goes back to the game that many flips early")
BB_ENV(BB_FLIP_RATE, TUNING, "=N: the flip rate the game asks for replaced (0: every vblank; games without frame rate hooks)")
BB_ENV(BB_FRAMES_AHEAD, TUNING, "=N (default 1): guest frames the command processor may run ahead of the GPU")
BB_ENV(BB_FRAME_HOOKS, TUNING, "=0: the community's frame rate patches instead of the port's hooks")
BB_ENV(BB_FSR3_FP32, TUNING, "=1: FSR 3.1 without its FP16 shader variants (#85)")
BB_ENV(BB_FSR3_WAVE32, TUNING, "=1: FSR 3.1 without its wave64 shader variants (#85)")
BB_ENV(BB_FSR4_LINEAR, TUNING, "=0: FSR 4 gets the encoded frame as before")
BB_ENV(BB_FSR4_OPT, TUNING, "=0: FSR 4 v07 passes without the optimized set (opt/)")
BB_ENV(BB_FX_INIT_CLEAR, TUNING, "=0: the effect buffers' initialization clears through the game's path")
BB_ENV(BB_GARLIC_VRAM, TUNING, "=0 / 1: VRAM copies of the game's GPU memory off / on (default: on discrete GPUs)")
BB_ENV(BB_GC_BUDGET_MB, TUNING, "=N: texture cache budget in MiB, as on integrated GPUs")
BB_ENV(BB_GC_IDLE_SECONDS, TUNING, "=N (default 20): unused textures evicted after N seconds")
BB_ENV(BB_GC_LIVE_BUDGET, TUNING, "=0: texture cache marks from the startup budget instead of the driver's current one")
BB_ENV(BB_GC_PRESSURE_IDLE_SECONDS, TUNING, "=N (default 5): the same under memory pressure")
BB_ENV(BB_GC_SMALL_MARKS, TUNING, "=P,C: pressure and critical marks in percent on small cards")
BB_ENV(BB_GC_THRASH_GUARD, TUNING, "=0 (macOS): the texture collector evicts images in use even when what is over its critical mark is not images (re-uploaded every tick)")
BB_ENV(BB_GEOMETRY_SHADERS, TUNING, "=0: the geometry stage hidden and its draws skipped (macOS A/B: KosmicKrisp emulates it with compute passes that end the render pass)")
BB_ENV(BB_GPU_COMMAND_WRITES, TUNING, "=0: GPU command writes not done in place")
BB_ENV(BB_GPU_DATA_CHECK, TUNING, "=0: GPU-written data not checked before CPU reads (#122)")
BB_ENV(BB_GPU_LABELS, TUNING, "=1 / 0: GPU-written labels on / off (default off on AMD GFX8)")
BB_ENV(BB_GPU_LABELS_PORTABLE, TUNING, "=1: portable GPU label writes")
BB_ENV(BB_GPU_QOS, TUNING, "=1 (macOS experiment): the threads every frame waits on run as user-interactive work (performance cores)")
BB_ENV(BB_GPU_SPIN_US, TUNING, "=N: microseconds the GPU thread spins before sleeping (default 200 with 12+ threads)")
BB_ENV(BB_GPU_TIMESTAMPS, TUNING, "=0: timestamps written by the CPU instead of the GPU")
BB_ENV(BB_GPU_WATCHDOG_MS, TUNING, "=N (macOS, Metal command path): milliseconds its committed Metal work may make no progress before the process exits (default 3000; 0: off; a stuck GPU takes WindowServer down)")
BB_ENV(BB_GPU_WRITES_IN_PLACE, TUNING, "=1: GPU-written buffers in place with write tracking, as before")
BB_ENV(BB_GPU_WRITE_TWINS, TUNING, "=1: VRAM twins of GPU-written guest pages")
BB_ENV(BB_GPU_WRITE_TWINS_MAX, TUNING, "=N: pages with at most N GPU-written ranges get twins (default 1024)")
BB_ENV(BB_GUEST_HOOKS, TUNING, "=0: no guest code hooks at all (aspect ratio, HUD, mouse, fixes)")
BB_ENV(BB_GUEST_LAZY, TUNING, "=1: lazy guest memory with the layer's memory module (off: broke buffers)")
BB_ENV(BB_GUEST_MEMORY, TUNING, "=dmabuf / host / private: how guest memory is shared with the GPU (default per vendor)")
BB_ENV(BB_GUEST_UNCACHED, TUNING, "=1: guest memory only in memory types the GPU reads past its caches")
BB_ENV(BB_GUEST_VRAM, TUNING, "=1 (experiment): direct memory in VRAM mapped through the PCI BAR")
BB_ENV(BB_GUEST_VRAM_RANGES, TUNING, "=lo-hi,...: physical ranges for BB_GUEST_VRAM (default: the graphics heaps)")
BB_ENV(BB_GX_COMMAND_HEAP, TUNING, "=0: without the larger GX command heap patch (patches.py)")
BB_ENV(BB_GX_QUERY_GUARD, TUNING, "=0: without the GX query creation guard")
BB_ENV(BB_HEAP_GROW, TUNING, "=0: the graphics heap whole from the start instead of growing on demand")
BB_ENV(BB_HEAP_GROW_AHEAD, TUNING, "=N (default 2, 0 off): heap pieces made ahead")
BB_ENV(BB_HEAP_GROW_INITIAL_MB, TUNING, "=N (default 512): heap memory backed from the start")
BB_ENV(BB_HEAP_GROW_PIECE_MB, TUNING, "=N (default 320, at least 258): heap growth piece")
BB_ENV(BB_HEAP_SHRINK, TUNING, "=0: the heap only grows")
BB_ENV(BB_HEAP_SHRINK_DELAY, TUNING, "=seconds (default 60): a piece free this long is given back")
BB_ENV(BB_HEAP_TOP_HOOK, TUNING, "=0: without the hook on allocations from the heap's top")
BB_ENV(BB_HIT_COLLECTOR_CAP, TUNING, "=N (default 65536): hits per call before the overflow fix takes over")
BB_ENV(BB_HONEST_DRAIN_FLUSH, TUNING, "=0: no flush when the GPU is on its last submission")
BB_ENV(BB_HONEST_FLIPS, TUNING, "=1 (experiment): a flip completes once the GPU has finished the frame")
BB_ENV(BB_HONEST_FLUSH_US, TUNING, "=N (default 2000): submissions batched over N microseconds while the GPU has work")
BB_ENV(BB_HONEST_IDLE_BACKLOG, TUNING, "=bytes (default 64 KiB): queued draws that make an idle GPU get a flush")
BB_ENV(BB_HONEST_IDLE_FLUSH, TUNING, "=0: no flush for an idle GPU")
BB_ENV(BB_HONEST_IDLE_US, TUNING, "=N (default 200): microseconds of GPU idle before the guest may be waiting")
BB_ENV(BB_HOST_COPY_WAITS, TUNING, "=all: host copies always wait, as before")
BB_ENV(BB_HOST_ONLY_DEFAULT, TUNING, "=0: none of the game profile's allocations in host memory only")
BB_ENV(BB_HOT_EFFECTS, TUNING, "=0: effect settings applied as patches at start instead of live")
BB_ENV(BB_HOT_PAGES, TUNING, "=1: hot page tracking")
BB_ENV(BB_IMAGE_RECYCLE_MB, TUNING, "=N (default 256, 0 off): memory of freed images kept for reuse")
BB_ENV(BB_IMAGE_RECYCLE_SECONDS, TUNING, "=N (default 90): recycled images older than this go")
BB_ENV(BB_IMAGE_SPARES, TUNING, "=1 / 0: spare images made ahead on a thread (default on on Windows)")
BB_ENV(BB_IMAGE_SPARES_MB, TUNING, "=N: memory for spare images")
BB_ENV(BB_IMAGE_TRAPS, TUNING, "=0: no write traps on image memory")
BB_ENV(BB_IMPORT_GRANULE_MB, TUNING, "=N (2..64, default 32): lazy guest memory import granule")
BB_ENV(BB_IMPORT_OVERLAP_MB, TUNING, "=N: overlap budget of lazy imports")
BB_ENV(BB_INDIRECT_GUARD, TUNING, "=0: indirect draw and dispatch counts used as the game gives them")
BB_ENV(BB_INDIRECT_GUARD_MAX, TUNING, "=N (default 4M): indirect dispatch groups allowed in all")
BB_ENV(BB_INDIRECT_GUARD_MAX_VERTICES, TUNING, "=N (default 64M): indirect draws over this run nothing")
BB_ENV(BB_INPLACE_TEXTURES, TUNING, "=1: all texture data read in place (off: looked smeared)")
BB_ENV(BB_INTERP_INT_FIX, TUNING, "=0 / 1: flat integer interpolation fix off / on (default: on where barycentrics exist)")
BB_ENV(BB_JOB_SLOT_FIX, TUNING, "=0: without the render job slot leak fix")
BB_ENV(BB_KEEP_DECOMPRESS_DRAWS, TUNING, "=1: the game's depth decompress passes are drawn")
BB_ENV(BB_KERNEL_CLAMP, TUNING, "=0: without the effect kernel clamp fix")
BB_ENV(BB_KIT_RESTORE, TUNING, "=0: the online kit's code changes are not restored")
BB_ENV(BB_LAYER_CPU_MARK_SECONDS, TUNING, "=N (default 5, 0: until handed out): CPU marks of layer blocks expire after N seconds")
BB_ENV(BB_LAYER_DOMAINS, TUNING, "=0: mirrors not per game allocation")
BB_ENV(BB_LAYER_GPU_WRITES, TUNING, "=0 / 1 / 2: where GPU writes may land in VRAM copies (0 nowhere, 1 default)")
BB_ENV(BB_LAYER_MIRROR_FLOOR_PERCENT, TUNING, "=N (max 90): VRAM budget share kept for mirrors")
BB_ENV(BB_LAYER_MIRROR_GROWTH_MB, TUNING, "=N (default 64, 0 none): room a growing mirror gets")
BB_ENV(BB_LAYER_MIRROR_HEADROOM_MB, TUNING, "=N (0: the whole floor): mirror headroom")
BB_ENV(BB_LAYER_READ_TRAPS, TUNING, "=1: data the GPU wrote into a VRAM copy only is trapped for CPU reads")
BB_ENV(BB_LAYER_RELOAD_RESET, TUNING, "=0: blocks reloaded in place keep their state, as before")
BB_ENV(BB_LAYER_STITCH, TUNING, "=0: bindings across heap pieces from the arena, as before (exploding vertices)")
BB_ENV(BB_LAYER_UNMAP_RESET, TUNING, "=0: unmapped blocks keep their state, as before")
BB_ENV(BB_LAYER_VOLATILE, TUNING, "=1: volatile blocks")
BB_ENV(BB_LAYER_VOLATILE_IN_PASS, TUNING, "=0: volatile blocks refreshed in render passes too, as before")
BB_ENV(BB_LAYER_WATCH, TUNING, "=0: blocks with unannounced bytes get no watched VRAM copy")
BB_ENV(BB_LAYER_WRITE_TRAPS, TUNING, "=0: no write traps on layer blocks")
BB_ENV(BB_LIGHT_GRID_HOOK, TUNING, "=0: without the light grid hook")
BB_ENV(BB_LIGHT_GRID_OPT, TUNING, "=1 / 0: light grid optimization on / off, over the setting (tests)")
BB_ENV(BB_LIST_RESTART, TUNING, "=1 (macOS): primitive restart kept on list topologies on KosmicKrisp (off there by default: each such indexed draw cost an extra compute dispatch)")
BB_ENV(BB_LIVE_HYBRID, TUNING, "=1: the startup resolution patch with live presets over it")
BB_ENV(BB_LOW_HEAP_TOP, TUNING, "=0: the low heap at the bottom of the low region again, as before 0.3 (A/B)")
BB_ENV(BB_MEM_BUDGET, TUNING, "=metal (macOS): the GPU memory budget is Metal's limit only, not also at most the Mac's RAM less what macOS keeps and the game process's footprint")
BB_ENV(BB_MEM_PRESSURE, TUNING, "=0 (macOS): macOS's memory pressure notifications ignored (else textures go sooner, at lower marks, for 30 s after one)")
BB_ENV(BB_MEM_RESERVE_MB, TUNING, "=N (macOS): MiB of RAM the GPU memory budget leaves macOS (default 20 %, at least 2.5 GiB)")
BB_ENV(BB_MEM_SEMAPHORE_ORDER, TUNING, "=0: memory semaphores without ordering")
BB_ENV(BB_METALFX_AUTO_RETRY, TUNING, "=0 (macOS): MetalFX not tried again by itself after a run-time failure (FSR 3.1 until it is chosen again; default: after 30 s, 2 min and 10 min)")
BB_ENV(BB_METALFX_EVENTS, TUNING, "=2 (default) / 1 / 0 (macOS): MetalFX from a thread of its own / that and GPU-side waits on Vulkan / on the submission thread with CPU waits")
BB_ENV(BB_METALFX_STALL_MS, TUNING, "=N (macOS): MetalFX work not done N ms after it went to Metal is given up, FSR 3.1 takes over (default 1000; 0: no cutoff)")
BB_ENV(BB_METALFX_SYNC, TUNING, "=1 (macOS): MetalFX synchronous (the CPU waits for each frame)")
BB_ENV(BB_METAL_EMULATED_WAIT_MS, TUNING, "=N (macOS, BB_METAL_FRAME): milliseconds a tessellated or geometry-shader draw waits for its Metal pipeline before KosmicKrisp's emulation draws it (default 1000; 0: no wait)")
BB_ENV(BB_METAL_FRAME, TUNING, "=1 (macOS, arm64 bb-gpu with SPIRV-Cross): the Metal command path, most GPU work encoded in Metal directly, the rest on KosmicKrisp (docs/MACOS_METAL_RENDERER.md; needs the validation layers off)")
BB_ENV(BB_METAL_HAZARD_TRACKING, TUNING, "=1 (macOS, Metal command path): Metal tracks hazards on every buffer instead of the explicit ordering")
BB_ENV(BB_METAL_ORDER, TUNING, "=barriers (macOS, BB_METAL_FRAME): Metal encoders between two of the renderer's barriers may overlap on the GPU (default chain: one after another)")
BB_ENV(BB_METAL_PRECISE, TUNING, "=all (macOS, Metal command path): exact float math kept in every stage (default: the stages that make positions only)")
BB_ENV(BB_METAL_SCRATCH_TRIM, TUNING, "=1 (macOS, BB_METAL_FRAME): the old small scratch pool, its buffers taken out of the residency set when given back")
BB_ENV(BB_MIRROR_ALLOC_PERCENT, TUNING, "=N (0 off): a mirror that would take device memory past N percent is refused")
BB_ENV(BB_MIRROR_COMPACT_AGE, TUNING, "=N (default 30): mirrors younger than N seconds are left alone")
BB_ENV(BB_MIRROR_COMPACT_MB, TUNING, "=N (default 64): mirror memory without valid blocks over this is given back")
BB_ENV(BB_MIRROR_COMPACT_SECONDS, TUNING, "=N (default 1): mirror compaction interval")
BB_ENV(BB_MIRROR_FREE_BACKLOG_MB, TUNING, "=N (default 128): retired mirror memory allowed to wait")
BB_ENV(BB_MIRROR_FREE_MB_PER_FRAME, TUNING, "=N (default 64): mirror memory freed per frame")
BB_ENV(BB_MIRROR_MERGE_GROWTH, TUNING, "=0: a mirror made over neighbours grows at the top only, as before")
BB_ENV(BB_MIRROR_POOL_MB, TUNING, "=N: retired mirrors kept for new ones")
BB_ENV(BB_MIRROR_REPROMOTE_SECONDS, TUNING, "=N (default 0): blocks sent back are not copied again that soon")
BB_ENV(BB_MIRROR_UNBOUND_SECONDS, TUNING, "=N (0 never): blocks no binding named for N seconds leave VRAM")
BB_ENV(BB_MIRROR_VRAM_ONLY, TUNING, "=1: mirrors in VRAM or not at all")
BB_ENV(BB_MOTION_LARGE, TUNING, "=0: large skeletons left to camera motion vectors, as before")
BB_ENV(BB_MOTION_MATCH, TUNING, "=order: repeated draws of one mesh find last frame's by draw order (the default off macOS), not by the nearest object")
BB_ENV(BB_MOTION_VERTICES_MI, TUNING, "=N (1-8): object motion vertex buffer in Mi vertices")
BB_ENV(BB_MSL_SAFE_MATH, TUNING, "=1 (macOS, Metal command path): Metal shaders compiled with safe math everywhere (default fast math, exact where the shader marks it)")
BB_ENV(BB_NET_MODULE, TUNING, "=path: the online module to load (default gpu/libbbnet20.so beside bb-probe)")
BB_ENV(BB_NP_COUNTRY, TUNING, "=code: the online user's country (default us)")
BB_ENV(BB_NP_LANGUAGE, TUNING, "=code: the online user's language (default en)")
BB_ENV(BB_NV_POWER, TUNING, "=0: leave the NVIDIA driver profile of bb-probe.exe alone (Windows; by default its power management mode is set to prefer maximum performance unless the user chose one)")
BB_ENV(BB_NVIDIA_EGL, TUNING, "=0: the launcher leaves the EGL vendor files as they are (#107)")
BB_ENV(BB_NVIDIA_LIB_DIR, TUNING, "=dir: extra folder with NVIDIA's libraries for the package")
BB_ENV(BB_NVIDIA_MAILBOX, TUNING, "set: keep Mailbox presentation on NVIDIA Windows instead of FIFO")
BB_ENV(BB_OCCLUSION_INTERVALS, TUNING, "=0: occlusion samples counted all the time, not only while a query is open")
BB_ENV(BB_OCCLUSION_LABEL_ORDER, TUNING, "=0: occlusion labels may go ahead")
BB_ENV(BB_OCCLUSION_QUERIES, TUNING, "=0: a fixed occlusion result sequence instead of real queries")
BB_ENV(BB_OF_FAST, TUNING, "=1: optical flow without a search on the finest level")
BB_ENV(BB_PACE_CATCHUP, TUNING, "=1: frame pacing catches up after a late frame")
BB_ENV(BB_PAD_CENTER, TUNING, "=lx,ly,rx,ry: the sticks' neutral position")
BB_ENV(BB_PAD_CENTER_CAL, TUNING, "=0: no measurement of the sticks' neutral position")
BB_ENV(BB_PAD_WORLD_DRAWS, TUNING, "=N (default 150): a frame with this many draws counts as the world for pad timing")
BB_ENV(BB_PAGED_CROSSING, TUNING, "=0: paged bindings only in windows")
BB_ENV(BB_PAGED_FORMATTED, TUNING, "=0: formatted buffers never paged")
BB_ENV(BB_PAGED_HOLES, TUNING, "=1 (experiment): paged reads skip memory the game never wrote")
BB_ENV(BB_PAGED_MIN_MB, TUNING, "=N (default 64): bindings from this size are paged")
BB_ENV(BB_PENDING_SUMMARY, TUNING, "=0: pending checks without the summary level")
BB_ENV(BB_PIPELINE_CACHE, TUNING, "=0: no pipeline cache on disk")
BB_ENV(BB_PIPE_SIGNALS, TUNING, "=0: the frame's cache work on the GPU thread instead of the recording thread")
BB_ENV(BB_PIPE_SPIN_US, TUNING, "=N: microseconds the draw pipe's threads spin before sleeping")
BB_ENV(BB_PM4_RECOVER, TUNING, "=0: a command buffer the game rewrote while read stops decoding, as before")
BB_ENV(BB_PM4_REPAIR, TUNING, "=0: corrupt submitted command buffers decoded as they are")
BB_ENV(BB_PM4_WAIT_US, TUNING, "=N (default 20000): command processor wait timeout in microseconds")
BB_ENV(BB_PRELOAD_BACKGROUND, TUNING, "=0: cached pipelines loaded before the game starts instead of in the background")
BB_ENV(BB_PREP_WORKERS, TUNING, "=N (0-16): draw preparation threads")
BB_ENV(BB_PRESENT_MODE, TUNING, "=Mailbox / Fifo / Immediate: swapchain present mode (default Mailbox)")
BB_ENV(BB_PRESENT_THREAD, TUNING, "=0: present on the vblank thread instead of its own")
BB_ENV(BB_PROMOTE_MB_PER_FRAME, TUNING, "=N (0 none; default 32 on cards up to 4 GiB, else 256): VRAM copies per frame")
BB_ENV(BB_READBACKS, TUNING, "=0 / 1 / 2: GPU readbacks off / relaxed (default) / precise")
BB_ENV(BB_READBACK_LINEAR, TUNING, "=1: linear images read back to guest memory")
BB_ENV(BB_READBACK_QUEUE, TUNING, "=0: no separate queue for readbacks")
BB_ENV(BB_REGS_FULL_RESET, TUNING, "set: the whole register file reset, as before")
BB_ENV(BB_REMOTE_FRESH_SYNC, TUNING, "=1 (native GPU process): the game's fresh GPU ranges reach bb-gpu as calls that return once its buffer cache has them, before the game writes there (default: messages; to measure)")
BB_ENV(BB_RENDER_RESOURCE_CACHE_MB, TUNING, "=N (160: the game's own): the game's render resource cache size")
BB_ENV(BB_REPAIRED_DRAWS, TUNING, "=1: repaired command buffers still draw")
BB_ENV(BB_REPAIRED_WAIT_MS, TUNING, "=N (default 500): waits of repaired command buffers give up after this")
BB_ENV(BB_RESOLVE_WORKERS, TUNING, "=N (0-4): threads that check and copy draw resources (stage 2)")
BB_ENV(BB_SCENE_DEPTH_PROXIES, TUNING, "=0: depth images read at the native size, not as reduced proxies")
BB_ENV(BB_SCENE_STENCIL_ZERO, TUNING, "=0: no depth proxies where stencil export is missing, the scene stays native")
BB_ENV(BB_SCENE_UPSIZE, TUNING, "=0: a scene larger than native drawn at the native size")
BB_ENV(BB_SCENE_WITHOUT_UI, TUNING, "=0: cinematics without a UI pass are not finished as scenes")
BB_ENV(BB_SHADOWS, TUNING, "=1: shadow copies of written buffers on discrete GPUs")
BB_ENV(BB_SKIP_EMPTY_DRAWS, TUNING, "=1 (experiment): draws that write nothing are left out")
BB_ENV(BB_SKIP_NOOP_DRAWS, TUNING, "=1: draws without effect left out (#352, no gain measured)")
BB_ENV(BB_SOUND_HACK, TUNING, "=0: saves left untouched (no sound settings fix)")
BB_ENV(BB_SPEC_MATCH, TUNING, "=0: shader specializations always built and compared")
BB_ENV(BB_SPIRV_PRECISE, TUNING, "=vertex (macOS): exact float math (NoContraction) only in the vertex, tessellation and geometry stages, not in fragment and compute shaders")
BB_ENV(BB_STAGE_PRIORITY, TUNING, "=0 (default) / 1 / 2: draw stage thread priority off / above normal / highest")
BB_ENV(BB_STAGING_KEEP_MB, TUNING, "=N (default 512): upload staging kept when idle")
BB_ENV(BB_STAGING_VRAM_IDLE_MS, TUNING, "=N (default 3000): VRAM staging given back after this long unused")
BB_ENV(BB_STREAM_BUFFER_MB, TUNING, "=N: stream buffer size")
BB_ENV(BB_SUBMIT_AHEAD, TUNING, "=N (default 2): a frame's first submissions go straight to the GPU")
BB_ENV(BB_SUBMIT_LOCK, TUNING, "=frame: a frame's last submission decoded under the lock")
BB_ENV(BB_SWAPCHAIN_IMAGES, TUNING, "=N: swapchain images")
BB_ENV(BB_SYNC_PIPELINE_WAIT_MS, TUNING, "=N: milliseconds a draw redrawn every frame waits for a pipeline it needs at once before it goes without it until compiled (default 250 on macOS; -1, the default elsewhere: as long as it takes)")
BB_ENV(BB_TESS_CLAMP, TUNING, "=1 (macOS): hull shader tessellation factors clamped to the game's maximum tess level (VGT_HOS_MAX_TESS_LEVEL), as the PS4 does")
BB_ENV(BB_TEXTURE_COMPRESSION, TUNING, "=0 (macOS, KosmicKrisp): images made with their full usage (storage, mutable formats), so that Metal does not compress them; also KosmicKrisp patch 0006's part")
BB_ENV(BB_TEXTURE_HELPER, TUNING, "=0 / 1: spinning texture helper thread (default: with cores to spare)")
BB_ENV(BB_TEXTURE_UPLOAD_MB_PER_FRAME, TUNING, "=N (default 32, 0 off): texture bytes uploaded a frame before new textures start small")
BB_ENV(BB_THD_AUTH, TUNING, "The Hunter's Dream account service URL")
BB_ENV(BB_THD_P2P_ADDR, TUNING, "our address for The Hunter's Dream peers (default: detected)")
BB_ENV(BB_THD_RULESET, TUNING, "The Hunter's Dream ruleset (default vanilla)")
BB_ENV(BB_THD_SERVER, TUNING, "The Hunter's Dream session service URL")
BB_ENV(BB_THD_STUN, TUNING, "=host[:port] / off: STUN server (default: the server's host on 3478)")
BB_ENV(BB_THD_VERIFY_TLS, TUNING, "=0: The Hunter's Dream TLS certificates not checked")
BB_ENV(BB_TILE_BIND_VRAM, TUNING, "=0: tiled data read in place over the bus instead of from a VRAM copy")
BB_ENV(BB_TIMELINE_POLL_US, TUNING, "=N (default 50): timeline semaphore poll interval")
BB_ENV(BB_UNIFIED_MEMORY, TUNING, "=1 / 0: treat the GPU as unified memory or not (over the device type)")
BB_ENV(BB_VBAO_BLUR, TUNING, "=N (default 2, 0: raw): VBAO denoise taps per side")
BB_ENV(BB_VBAO_BLUR_DEPTH, TUNING, "=f (default 0.05): relative depth difference that stops the VBAO blur")
BB_ENV(BB_VBAO_BLUR_NORMAL, TUNING, "=f (default 8, 0 ignores normals): how sharply the VBAO blur stops at normal changes")
BB_ENV(BB_VBAO_NORMALS, TUNING, "=0: VBAO from depth only")
BB_ENV(BB_VBAO_POWER, TUNING, "=f (default 1.5): VBAO strength")
BB_ENV(BB_VBAO_RADIUS, TUNING, "=metres (default 1.5): VBAO radius")
BB_ENV(BB_VBAO_THICKNESS, TUNING, "=metres (default 0.4): VBAO assumed thickness")
BB_ENV(BB_VK_RECORD_THREAD, TUNING, "=0: Vulkan commands recorded on the calling thread")
BB_ENV(BB_VK_RECORD_THREADS, TUNING, "=N (1-8): Vulkan recording threads (default 2 from 8 hardware threads)")
BB_ENV(BB_VK_SEGMENT_KB, TUNING, "=N (default 64): recording segment size")
BB_ENV(BB_VMA_BLOCK_MB, TUNING, "=N (default 64): VMA block size")
BB_ENV(BB_VMA_DEDICATED_MB, TUNING, "=N (default 4): images from this size get dedicated memory")
BB_ENV(BB_VRAM_FLOOR_IDLE_SECONDS, TUNING, "=N (default 30): mirror floor idle time before textures make room")
BB_ENV(BB_VRAM_IDLE_SECONDS, TUNING, "=N (default 60): VRAM copies unused this long are given back")
BB_ENV(BB_VRAM_LIMIT_MB, TUNING, "=N: the driver's VRAM budget taken as at most N MiB")
BB_ENV(BB_VRAM_PRESSURE_IDLE_SECONDS, TUNING, "=N (default 10): under pressure, VRAM groups unused this long go")
BB_ENV(BB_VRAM_PROMOTE_PERCENT, TUNING, "=N (default 90): no new VRAM copies past this share of the budget")
BB_ENV(BB_VULKANINFO, TUNING, "path of vulkaninfo for the launcher")
BB_ENV(BB_WORK_RETIRED, TUNING, "=0: the recording thread and fences do not wait for retired work")

// Diagnostics: logs, dumps, traces, probes, experiments; for finding bugs, not for playing.
BB_ENV(BB_ARENA_VRAM_ONLY, DEBUG, "=1 (tests): the arena in VRAM only, as NVIDIA's sparse buffers")
BB_ENV(BB_AUDIO_DUMP, DEBUG, "=dir: raw converted PCM per audio port")
BB_ENV(BB_AUDIO_STATS, DEBUG, "set: audio port statistics")
BB_ENV(BB_AUDIO_TRACE, DEBUG, "=1: Ajm instance configurations and jobs that fail")
BB_ENV(BB_AVPLAYER_TRACE, DEBUG, "=1: the game's movie player calls with results and times")
BB_ENV(BB_BARRIER_STATS, DEBUG, "=1: images whose subresource states cost the most")
BB_ENV(BB_BBSC_MEMSCAN, DEBUG, "set: BBSC finds its sites by scanning memory instead of the known addresses")
BB_ENV(BB_BBSC_PROBE, DEBUG, "=address: BBSC probe of that guest address")
BB_ENV(BB_BDA_LOG, DEBUG, "set: GPU addresses of buffer sources, to place a GPUVM fault")
BB_ENV(BB_BIG_ALLOC_STACKS, DEBUG, "=1: call stacks of device memory allocations of 64 MiB and more")
BB_ENV(BB_BREADCRUMB_READS, DEBUG, "=1 / 0: breadcrumbs of T# and V# reads everywhere / nowhere (default: NVIDIA only)")
BB_ENV(BB_BUFFER_STATS, DEBUG, "=1: how many frames behind the GPU is when a frame starts")
BB_ENV(BB_CAMERA_FRAME_LOG, DEBUG, "set: projection of every G-buffer pass's camera with its GPU frame")
BB_ENV(BB_CAMERA_INVERSE, DEBUG, "=own: motion vectors from the inverse of the view matrix instead of the game's stored one")
BB_ENV(BB_CAMERA_LOG, DEBUG, "set: camera position every 100 ms")
BB_ENV(BB_CAMERA_Y, DEBUG, "=up / down: force the camera's y direction for motion vectors")
BB_ENV(BB_CAMLOG, DEBUG, "set: camera yaw when it changes (#325)")
BB_ENV(BB_CAPTURE_DIR, DEBUG, "folder for frame captures (BB_CAPTURE_TRIGGER)")
BB_ENV(BB_CAPTURE_TRIGGER, DEBUG, "=file: creating that file records the next frame for the frame analyzer")
BB_ENV(BB_CE_STATS, DEBUG, "=1: what the constant engine's dumps feed")
BB_ENV(BB_CE_WAIT_LOG, DEBUG, "set: constant engine waits that were not satisfied")
BB_ENV(BB_CE_WATCH, DEBUG, "=hex address: constant RAM dumps and WRITE_DATA packets over that address")
BB_ENV(BB_CLOTH_STIFFNESS, DEBUG, "=value: cloth stiffness bound at any frame rate")
