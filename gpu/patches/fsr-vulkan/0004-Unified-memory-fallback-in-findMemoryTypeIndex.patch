+            if (requestedProperties == VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT && (memoryProperties & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT)) {
+                if (hostVisibleLocalFallback == UINT32_MAX) {
+                    hostVisibleLocalFallback = i;
+                    fallbackProperties = memoryProperties;
+                }
                 continue;
+            }
 
             bestCandidate = i;
             outProperties = memoryProperties;
@@ -460,6 +469,10 @@ uint32_t findMemoryTypeIndex(
         }
     }
 
+    if (bestCandidate == UINT32_MAX && hostVisibleLocalFallback != UINT32_MAX) {
+        outProperties = fallbackProperties;
+        return hostVisibleLocalFallback;
+    }
     return bestCandidate;
 }
 
