+#ifdef VK_USE_PLATFORM_METAL_EXT
+/* bbport: VK_EXT_metal_objects, limited to the MTLSharedEvent of a timeline semaphore (every
+ * KosmicKrisp semaphore is one). Lets Metal work outside the driver (MetalFX) wait for and
+ * signal Vulkan timelines on the GPU. Other export requests are left unfilled (null). */
+VKAPI_ATTR void VKAPI_CALL
+kk_ExportMetalObjectsEXT(UNUSED VkDevice device,
+                         VkExportMetalObjectsInfoEXT *pMetalObjectsInfo)
+{
+   for (VkBaseOutStructure *ext = (VkBaseOutStructure *)pMetalObjectsInfo->pNext;
+        ext != NULL; ext = ext->pNext) {
+      if (ext->sType != VK_STRUCTURE_TYPE_EXPORT_METAL_SHARED_EVENT_INFO_EXT)
+         continue;
+      VkExportMetalSharedEventInfoEXT *info =
+         (VkExportMetalSharedEventInfoEXT *)ext;
+      info->mtlSharedEvent = NULL;
+      if (info->semaphore == VK_NULL_HANDLE)
+         continue;
+      VK_FROM_HANDLE(vk_semaphore, semaphore, info->semaphore);
+      struct vk_sync *sync = vk_semaphore_get_active_sync(semaphore);
+      if (sync->type != &kk_sync_type)
+         continue;
+      info->mtlSharedEvent =
+         (MTLSharedEvent_id)container_of(sync, struct kk_sync_timeline, base)
+            ->mtl_handle;
+   }
+}
+#endif /* VK_USE_PLATFORM_METAL_EXT */
