  </enum>

  <enum name="GAMMA">
    <doc>Sets the gamma mode.</doc>
    <value name="OFF" value="0"/>
    <value name="ON"  value="1"/>
  </enum>

  <enum name="SWIZ">
    <doc>Sets the swizzle.</doc>
    <value name="SRCCHAN_0" value="0"/>
    <value name="SRCCHAN_1" value="1"/>
    <value name="SRCCHAN_2" value="2"/>
    <value name="SRCCHAN_3" value="3"/>
    <value name="SRC_ONE"   value="4"/>
    <value name="SRC_ZERO"  value="5"/>
  </enum>

  <enum name="TEXTYPE">
    <doc>Sets the texture type.</doc>
    <value name="1D"            value="0"/>
    <value name="2D"            value="1"/>
    <value name="3D"            value="2"/>
    <value name="CUBE"          value="3"/>
    <value name="STRIDE"        value="4"/>
    <value name="PAGETILE"      value="5"/>
    <value name="BUFFER_LOOKUP" value="6"/>
  </enum>

  <enum name="TWOCOMP_GAMMA">
    <doc>Sets the gamma mode for 2 component textures.</doc>
    <value name="OFF" value="0"/>
    <value name="R"   value="1"/>
    <value name="RG"  value="3"/>
  </enum>

  <!-- FIXME: This is the definition for hardware with TPU_IMAGE_STATE_V2.
       Add V1 definition when condition tags can be nested in enum tags.
  -->
  <enum name="CHROMAINTERP">
    <doc>Sets the Chroma interpolation.</doc>
    <value name="ZERO"  value="0"/>
    <value name="ENABLED" value="1"/>
  </enum>

  <struct name="IMAGE_WORD0" length="2">
    <field name="smpcnt" start="62" end="63" type="uint">
      <doc>Sample count [0 = 1].</doc>
    </field>
    <field name="height" start="48" end="61" type="uint">
      <doc>Texture height [0 = 1].</doc>
    </field>
    <field name="width" start="34" end="47" type="uint">
      <doc>Texture width [0 = 1].</doc>
      <define name="MAX_SIZE" value="16383"/>
    </field>
    <field name="texformat" start="27" end="33" type="FORMAT">
      <doc>Texture format.</doc>
      <define name="MAX_SIZE" value="127"/>
    </field>
    <field name="texformat_compressed" start="27" end="33" type="FORMAT_COMPRESSED">
      <doc>Compressed texture format.</doc>
    </field>
    <field name="minlod" start="17" end="26" type="uint">
      <doc>4.6 number format. Upper mipmap clamping level.</doc>
    </field>
    <field name="swiz0" start="14" end="16" type="SWIZ">
      <doc>Blue swizzle.</doc>
    </field>
    <field name="swiz1" start="11" end="13" type="SWIZ">
      <doc>Green swizzle.</doc>
    </field>
    <field name="swiz2" start="8" end="10" type="SWIZ">
      <doc>Red Swizzle.</doc>
    </field>
    <field name="swiz3" start="5" end="7" type="SWIZ">
      <doc>Alpha Swizzle.</doc>
    </field>
    <field name="twocomp_gamma" start="3" end="4" type="TWOCOMP_GAMMA">
      <doc>Gamma for 2 component textures.</doc>
    </field>
    <field name="gamma" start="3" end="3" type="GAMMA">
      <doc>Gamma.</doc>
    </field>
    <field name="textype" start="0" end="2" type="TEXTYPE">
      <doc>Texture type.</doc>
    </field>
  </struct>

  <struct name="IMAGE_WORD1" length="2">
    <field name="baselevel" start="60" end="63" type="uint">
      <doc>Integer value to add to the LOD in order to rebase the top level.</doc>
    </field>
    <field name="alpha_msb" start="59" end="59" type="bool">
      <doc>When set to '1' the alpha channel is at most significant channel, [31:24], otherwise alpha channel is in [7:0].</doc>
    </field>
    <field name="border" start="58" end="58" type="bool">
      <doc>Are there border texels.</doc>
    </field>
    <condition type="if" check="TPU_IMAGE_STATE_V2"/>
      <condition type="if" check="TFBC"/>
        <field name="lossy_compression_mode" start="56" end="57" type="COMPRESSION_LEVEL">
          <doc>Enables lossy frame buffer compression.</doc>
        </field>
      <condition type="endif" check="TFBC"/>
      <field name="tpu_image_state_v2_compression_mode" start="54" end="56" type="COMPRESSION_MODE">
        <doc>Mode for compression, can be TPU or FBC.</doc>
      </field>
    <condition type="else" check="TPU_IMAGE_STATE_V2"/>
      <field name="tile_size" start="57" end="57" type="bool">
        <doc>Tile size for frame buffer compression, 0 8x8, 1 16x4.</doc>
      </field>
      <field name="index_lookup" start="56" end="56" type="bool">
        <doc>Integer texture coordinate lookup in the range 0,2^32.</doc>
      </field>
      <field name="frame_buffer_compression" start="55" end="55" type="bool">
        <doc>Flag to indicate if frame buffer compression is used.</doc>
      </field>
      <field name="frame_buffer_compression_addressing_mode" start="54" end="54" type="bool">
        <doc>Flag to indicate the addressmode to be used when frame buffer compression is enabled: 0 direct addressing, 1 indirect addressing.</doc>
      </field>
    <condition type="endif" check="TPU_IMAGE_STATE_V2"/>
    <field name="texaddr" start="16" end="53" shift="2" type="address">
      <doc>Address in 32-bit units.</doc>
    </field>
    <field name="mipmaps_present" start="15" end="15" type="bool">
      <doc>Flag to indicate that mipmaps are present (value 1) or not (value 0). The HW expects the full mipmap chain down to 1x1 (exceptions apply for some texture formats and 3D where the minimum memory alignment is 4x4x4) to be present, regardless of the value of the NUM_MIP_LEVELS. It does not apply to YUV planar textures.</doc>
    </field>
    <field name="depth" start="4" end="14" type="uint">
      <doc>Depth of 3D texture [0 = 1].</doc>
      <define name="MAX_SIZE" value="2047"/>
    </field>
    <field name="num_mip_levels" start="0" end="3" type="uint">
      <doc>Number of miplevels. Must be at least 1.</doc>
    </field>
  </struct>

  <struct name="STRIDE_IMAGE_WORD1" length="2">
    <field name="num_mip_levels" start="60" end="63" type="uint">
      <doc>Number of miplevels. Must be at least 1.</doc>
    </field>
    <field name="alpha_msb" start="59" end="59" type="bool">
      <doc>When set to '1' the alpha channel is at most significant channel, [31:24], otherwise alpha channel is in [7:0].</doc>
    </field>
    <condition type="if" check="TPU_IMAGE_STATE_V2"/>
      <condition type="if" check="TFBC"/>
        <field name="lossy_compression_mode" start="56" end="57" type="COMPRESSION_LEVEL">
          <doc>Enables lossy frame buffer compression.</doc>
        </field>
      <condition type="endif" check="TFBC"/>
      <field name="tpu_image_state_v2_compression_mode" start="54" end="56" type="COMPRESSION_MODE">
        <doc>Mode for compression, can be TPU or FBC.</doc>
      </field>
    <condition type="else" check="TPU_IMAGE_STATE_V2"/>
      <field name="tile_size" start="57" end="57" type="bool">
        <doc>Tile size for frame buffer compression, 0 8x8, 1 16x4.</doc>
      </field>
      <field name="index_lookup" start="56" end="56" type="bool">
        <doc>Integer texture coordinate lookup in the range 0,2^32.</doc>
      </field>
      <field name="frame_buffer_compression" start="55" end="55" type="bool">
        <doc>Flag to indicate if frame buffer compression is used.</doc>
      </field>
      <field name="frame_buffer_compression_addressing_mode" start="54" end="54" type="bool">
        <doc>Flag to indicate the addressmode to be used when frame buffer compression is enabled: 0 direct addressing, 1 indirect addressing.</doc>
      </field>
    <condition type="endif" check="TPU_IMAGE_STATE_V2"/>
    <field name="texaddr" start="16" end="53" shift="2" type="address">
      <doc>Address in 32-bit units.</doc>
    </field>
    <field name="mipmaps_present" start="15" end="15" type="bool">
      <doc>Flag to indicate that mipmaps are present (value 1) or not (value 0). The HW expects the full mipmap chain down to 1x1 (exceptions apply for some texture formats and 3D where the minimum memory alignment is 4x4x4) to be present, regardless of the value of the NUM_MIP_LEVELS. It does not apply to YUV planar textures.</doc>
    </field>
    <field name="stride" start="0" end="14" type="uint">
      <doc>Stride in pixels [0 = 1].</doc>
    </field>
  </struct>

  <struct name="YUV_IMAGE_WORD1" length="2">
    <field name="csc_coeff_index" start="60" end="63" type="uint">
      <doc>CSC coefficient index.</doc>
    </field>
    <field name="chroma_interpolation_v" start="59" end="59" type="CHROMAINTERP">
      <doc>Enable chroma interpolation for YUV planar textures.</doc>
    </field>
    <field name="chroma_interpolation_u" start="53" end="53" type="CHROMAINTERP">
      <doc>Enable chroma interpolation for YUV planar textures.</doc>
    </field>
    <field name="stride" start="38" end="52" type="uint">
      <doc>Stride in pixels [0 = 1].</doc>
    </field>
    <field name="texaddr" start="0" end="37" shift="2" type="address">
      <doc>Address in 32-bit units.</doc>
    </field>
  </struct>

  <struct name="SAMPLER_WORD0" length="2">
    <field name="texaddr_plane2_lo" start="50" end="63" shift="2" type="address">
      <doc>Second plane base address for YUV 2 + 3 planar texture format, DWord granularity.</doc>
    </field>
    <field name="cmp_mode" start="59" end="61" type="CMP_MODE">
      <doc>Comparison modes required for comparison filtering.</doc>
    </field>
    <field name="addrmode_w" start="56" end="58" type="ADDRMODE">
      <doc>Aka WRAP_R.</doc>
    </field>
    <field name="bordercolor_index" start="50" end="55" type="uint">
      <doc>Index into border colour palette.</doc>
      <define name="MAX_SIZE" value="63"/>
    </field>
    <field name="non_normalized_coords" start="49" end="49" type="bool">
      <doc>Flag to indicate that input texture coordinates are no-normalised, i.e., in the range [0,width-1] [0, height-1].</doc>
    </field>
    <field name="lumakey_alphamult" start="48" end="48" type="bool">
      <doc>Multiply alpha by lumakey alpha.</doc>
    </field>
    <field name="lumakey" start="47" end="47" type="bool">
      <doc>Enable for Lumakey.</doc>
    </field>
    <field name="addrmode_v" start="44" end="46" type="ADDRMODE">
      <doc>Aka WRAP_T.</doc>
    </field>
