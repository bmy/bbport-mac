diff --git a/src/kosmickrisp/vulkan/kk_device.c b/src/kosmickrisp/vulkan/kk_device.c
index 9950b19..e6aa58c 100644
--- a/src/kosmickrisp/vulkan/kk_device.c
+++ b/src/kosmickrisp/vulkan/kk_device.c
@@ -29,8 +29,94 @@
 #include "vulkan/wsi/wsi_common.h"
 #include "vk_pipeline_cache.h"
 
+#include <stdio.h>
 #include <time.h>
 
+#include "util/os_time.h"
+#include "util/u_debug.h"
+
+/* bbport (issue #6, diagnostics): see kk_device.h. */
+int64_t kk_bbstats[KK_BBSTAT_COUNT];
+
+static bool
+kk_bb_env_flag(int *cache, const char *name)
+{
+   int on = p_atomic_read(cache);
+   if (on < 0) {
+      on = debug_get_bool_option(name, false) ? 1 : 0;
+      p_atomic_set(cache, on);
+   }
+   return on != 0;
+}
+
+bool
+kk_bbstats_enabled(void)
+{
+   static int enabled = -1;
+   return kk_bb_env_flag(&enabled, "BB_KK_STATS");
+}
+
+bool
+kk_bb_pool_fix(void)
+{
+   static int enabled = -1;
+   return kk_bb_env_flag(&enabled, "BB_KK_POOL_FIX");
+}
+
+void
+kk_bbstats_maybe_print(void)
+{
+   static int64_t next_ns = 0;
+
+   if (!kk_bbstats_enabled())
+      return;
+
+   const int64_t now = os_time_get_nano();
+   const int64_t next = p_atomic_read(&next_ns);
+   if (now < next)
+      return;
+   if (p_atomic_cmpxchg(&next_ns, next, now + 10ll * 1000000000ll) != next)
+      return; /* another thread prints this one */
+
+   long long s[KK_BBSTAT_COUNT];
+   for (unsigned i = 0; i < KK_BBSTAT_COUNT; i++)
+      s[i] = (long long)p_atomic_read(&kk_bbstats[i]);
+   s[KK_BBSTAT_ALLOCATOR_SAMPLE_BYTES] =
+      (long long)p_atomic_xchg(&kk_bbstats[KK_BBSTAT_ALLOCATOR_SAMPLE_BYTES], 0);
+   s[KK_BBSTAT_ALLOCATOR_SAMPLES] =
+      (long long)p_atomic_xchg(&kk_bbstats[KK_BBSTAT_ALLOCATOR_SAMPLES], 0);
+   s[KK_BBSTAT_ALLOCATOR_MAX_BYTES] =
+      (long long)p_atomic_xchg(&kk_bbstats[KK_BBSTAT_ALLOCATOR_MAX_BYTES], 0);
+   const long long avg_kib = s[KK_BBSTAT_ALLOCATOR_SAMPLES]
+      ? (s[KK_BBSTAT_ALLOCATOR_SAMPLE_BYTES] / s[KK_BBSTAT_ALLOCATOR_SAMPLES]) >> 10
+      : 0;
+
+   fprintf(stderr,
+           "KosmicKrisp: heaps %lld live, %lld MiB (created %lld, destroyed %lld; "
+           "upload blocks %lld/%lld, large uploads %lld/%lld); "
+           "Metal command buffers %lld live (%lld created); "
+           "command allocators %lld, %lld KiB on average when returned (largest %lld KiB, "
+           "so about %lld MiB in all); "
+           "images %lld, image views %lld, buffer views %lld, buffers %lld, "
+           "samplers %lld, shaders %lld, timelines %lld; "
+           "Metal commits %lld (re-recorded %lld); "
+           "command pools %lld, %lld of them started with a junk spare-block count%s\n",
+           s[KK_BBSTAT_HEAPS_CREATED] - s[KK_BBSTAT_HEAPS_DESTROYED],
+           s[KK_BBSTAT_HEAP_BYTES] >> 20,
+           s[KK_BBSTAT_HEAPS_CREATED], s[KK_BBSTAT_HEAPS_DESTROYED],
+           s[KK_BBSTAT_UPLOAD_BLOCKS_CREATED], s[KK_BBSTAT_UPLOAD_BLOCKS_DESTROYED],
+           s[KK_BBSTAT_LARGE_UPLOADS_CREATED], s[KK_BBSTAT_LARGE_UPLOADS_DESTROYED],
+           s[KK_BBSTAT_MTL_CMD_BUFS_CREATED] - s[KK_BBSTAT_MTL_CMD_BUFS_RELEASED],
+           s[KK_BBSTAT_MTL_CMD_BUFS_CREATED],
+           s[KK_BBSTAT_ALLOCATORS], avg_kib, s[KK_BBSTAT_ALLOCATOR_MAX_BYTES] >> 10,
+           (s[KK_BBSTAT_ALLOCATORS] * avg_kib) >> 10,
+           s[KK_BBSTAT_IMAGES], s[KK_BBSTAT_IMAGE_VIEWS], s[KK_BBSTAT_BUFFER_VIEWS],
+           s[KK_BBSTAT_BUFFERS], s[KK_BBSTAT_SAMPLERS], s[KK_BBSTAT_SHADERS],
+           s[KK_BBSTAT_TIMELINES], s[KK_BBSTAT_COMMITS], s[KK_BBSTAT_RERECORDS],
+           s[KK_BBSTAT_CMD_POOLS], s[KK_BBSTAT_CMD_POOLS_JUNK_COUNT],
+           kk_bb_pool_fix() ? " (reset to 0: BB_KK_POOL_FIX)" : "");
+}
+
 struct kk_mtl_compiler {
    mtl_compiler *handle;
    uint32_t refcount;
