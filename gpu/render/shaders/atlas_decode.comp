// bbport: the HUD atlas's copy for the port's key guide icons (vk_button_prompts.cpp): the game's
// block-compressed image read through an UNORM view (its stored values, no sRGB decoding) into an
// rgba8 image. Sampling a BC image works on every device; a blit from one left the copy empty on
// AMD's Windows driver (2026-10-27).
#version 450
#extension GL_EXT_samplerless_texture_functions : require
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform texture2D source_tex;
layout(binding = 1, rgba8) uniform writeonly image2D result_img;

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(result_img)))) {
        return;
    }
    imageStore(result_img, pixel, texelFetch(source_tex, pixel, 0));
}
