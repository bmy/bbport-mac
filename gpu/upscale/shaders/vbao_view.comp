// bbport: AO-only debug view: the game's AO target (VBAO or the game's own SSAO) as grey over the
// finished frame, see vk_vbao.h.
#version 450
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform texture2D ao_tex; // AO in red (R8, or the half-size RGBA8)
layout(binding = 1, rgba8) uniform writeonly image2D frame_img;

layout(push_constant) uniform Constants {
    vec2 frame_size;
    vec2 ao_size; // the AO target's written region
};

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, ivec2(frame_size)))) {
        return;
    }
    const ivec2 src = min(ivec2((vec2(pixel) + 0.5) * ao_size / frame_size), ivec2(ao_size) - 1);
    imageStore(frame_img, pixel, vec4(vec3(texelFetch(ao_tex, src, 0).r), 1.0));
}
