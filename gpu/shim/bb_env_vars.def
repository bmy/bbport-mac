BB_ENV(BB_CONSTRAM_WAIT_LOG, DEBUG, "set: constant RAM dumps that waited for the GPU, sampled")
BB_ENV(BB_COPY_SHADER_TRACE, DEBUG, "set: the copy shader's buffers every 2 s")
BB_ENV(BB_DCB_STATS, DEBUG, "=1: structure of the graphics command buffers")
BB_ENV(BB_DEBUG_MOTION, DEBUG, "=1: motion vectors blended over the picture")
BB_ENV(BB_DISPATCH_LOG, DEBUG, "=1: the shape of each kind of compute dispatch, once")
BB_ENV(BB_DISPATCH_START_LOG, DEBUG, "set: dispatches with a nonzero thread group start")
BB_ENV(BB_DISPLAY_WATCH, DEBUG, "set: every draw into a display buffer with its sizes and state")
BB_ENV(BB_DISPLAY_WATCH_TARGET, DEBUG, "=hex address: also every draw into that color target")
BB_ENV(BB_DLSSG_CAMERA_MOTION, DEBUG, "=0: DLSS-G told the vectors have no camera motion")
