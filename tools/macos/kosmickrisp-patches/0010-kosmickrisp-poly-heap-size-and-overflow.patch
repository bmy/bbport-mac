-   uint alloc_B = poly_heap_alloc_offs(p->heap, size_B, 16);
-   p->index_buffer = (global uint32_t *)(((uintptr_t)p->heap->base) + alloc_B);
 
    /* ...and now we can generate the API indexed draw */
    global uint32_t *desc = p->out_draws;
 
+   /* bbport: what this draw takes from the heap, the indices now and the
+    * domain points the second tessellation pass allocates per patch (at most
+    * one point per index, each allocation with its alignment), must fit. An
+    * overflow aborts the allocating thread (printf_abort is a return in this
+    * driver): here the draw descriptor would be left as it was, an indexed
+    * draw of whatever count the pool memory held, which can keep the GPU busy
+    * until macOS stops the command buffer. Such a draw draws nothing instead:
+    * no indices, and an instance count of 0, which the second pass's kernels
+    * take as "skip every patch" (the descriptor is written on every run, so a
+    * command buffer submitted again starts over).
+    */
+   uint64_t need_B = (uint64_t)size_B + 16u +
+                     (uint64_t)total * sizeof(struct poly_tess_point) +
+                     (uint64_t)p->nr_patches * 32u;
+   if ((uint64_t)p->heap->bottom + need_B >= (uint64_t)p->heap->size) {
+      p->index_buffer = (global uint32_t *)p->heap->base;
+      desc[0] = 0; /* count */
+      desc[1] = 0; /* instance_count */
+      desc[2] = 0;
+      desc[3] = 0;
+      desc[4] = 0;
+      return;
+   }
+
+   uint alloc_B = poly_heap_alloc_offs(p->heap, size_B, 16);
+   p->index_buffer = (global uint32_t *)(((uintptr_t)p->heap->base) + alloc_B);
+
    desc[0] = total;              /* count */
    desc[1] = 1;                  /* instance_count */
    desc[2] = alloc_B / elsize_B; /* start */
