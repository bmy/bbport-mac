BB_ENV(BB_LOG_LONG_CB_MS, DEBUG, "=N (macOS, Metal command path): Metal command buffers whose GPU time, or the GPU's idle time before them, reaches N ms are logged")
BB_ENV(BB_METALFX_DEPTH_REVERSED, DEBUG, "=1 (macOS): MetalFX told the depth is reversed (A/B of the conventions)")
BB_ENV(BB_METALFX_INVERT_JITTER, DEBUG, "=1 (macOS): MetalFX gets the jitter with the other sign (A/B)")
BB_ENV(BB_METALFX_INVERT_MOTION, DEBUG, "=1 (macOS): MetalFX gets the motion vectors negated (A/B)")
BB_ENV(BB_METALFX_TEST_STALL, DEBUG, "=N (macOS test): the 600th frame of each of MetalFX's first N worker runs waits 10 s on the GPU")
BB_ENV(BB_METAL_DESCRIPTOR_SETS, DEBUG, "=0 (macOS, BB_METAL_FRAME): draws reading descriptor sets go to KosmicKrisp (bisecting)")
BB_ENV(BB_METAL_FENCE_CHECK, DEBUG, "=0 (macOS, Metal command path): fence waits not checked on the CPU (on by default: waits that could stop the GPU are counted and the first logged)")
BB_ENV(BB_METAL_FLAT_LAST, DEBUG, "=1 (macOS, BB_METAL_FRAME): draws with flat inputs from the last vertex stay in Metal (which takes them from the first)")
BB_ENV(BB_METAL_FORMAT_VARIANTS, DEBUG, "=0 (macOS, BB_METAL_FRAME): no depth/stencil format variants of a pipeline for the pass it draws in (bisecting)")
BB_ENV(BB_METAL_FRAME_TEST, DEBUG, "=1 (macOS, with BB_METAL_FRAME=1): ordering self-test of KosmicKrisp's and the Metal path's writes at the renderer's start (PASS or what landed out of order)")
BB_ENV(BB_METAL_GENERIC, DEBUG, "=0 (macOS, Metal command path): the renderer's own pipelines stay on KosmicKrisp")
BB_ENV(BB_METAL_GEOMETRY, DEBUG, "=0 (macOS, BB_METAL_FRAME): geometry-shader draws stay on KosmicKrisp (bisecting)")
BB_ENV(BB_METAL_GEOMETRY_INDIRECT, DEBUG, "=0 (macOS, BB_METAL_FRAME): indirect geometry-shader draws stay on KosmicKrisp")
BB_ENV(BB_METAL_GPU_DIAG, DEBUG, "=1 (macOS, BB_METAL_FRAME): encoder status on GPU errors, labelled encoders and a signpost per draw and dispatch")
BB_ENV(BB_METAL_INTEROP_TEST, DEBUG, "=1 (macOS): Vulkan/Metal ordering test on KosmicKrisp's queue at the renderer's start (PASS or where it failed); =2: without the render pass's barriers (a negative control)")
BB_ENV(BB_METAL_KEEP_AFTER_ERROR, DEBUG, "=1 (macOS, BB_METAL_FRAME): encoding in Metal goes on after a GPU error (else everything goes to KosmicKrisp from then on)")
BB_ENV(BB_METAL_SHADOW, DEBUG, "=1 (macOS, bb-gpu with the Metal command path): every game pipeline also built as a Metal pipeline state, the results counted in the log (BB_METAL_FRAME=1 does it too)")
BB_ENV(BB_METAL_STRIP_RESTART, DEBUG, "=0 (macOS, BB_METAL_FRAME): strips drawn without primitive restart go to KosmicKrisp (as before)")
