  <enum name="FORMAT_COMPRESSED">
    <doc>Sets the texture format.</doc>
    <value name="ASTC_4x4"           value="0"/>
    <value name="ASTC_5x4"           value="1"/>
    <value name="ASTC_5x5"           value="2"/>
    <value name="ASTC_6x5"           value="3"/>
