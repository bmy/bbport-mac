<csbgen name="ROGUE" prefix="TEXSTATE">

  <enum name="ADDRMODE">
    <doc>Specifies texture address mode.</doc>
    <value name="REPEAT"               value="0"/>
    <value name="FLIP"                 value="1"/>
    <value name="CLAMP_TO_EDGE"        value="2"/>
    <value name="FLIP_ONCE_THEN_CLAMP" value="3"/>
    <value name="CLAMP_TO_BORDER"      value="4"/>
    <value name="OGL_CLAMP"            value="5"/>
  </enum>

  <enum name="ANISOCTL">
    <doc>Specifies maximum anisotropy.</doc>
    <value name="DISABLED" value="0">
      <doc>No Aniso.</doc>
    </value>
    <value name="X2"       value="1">
      <doc>Aniso X2.</doc>
    </value>
    <value name="X4"       value="2">
      <doc>Aniso X4.</doc>
    </value>
    <value name="X8"       value="3">
      <doc>Aniso X8.</doc>
    </value>
    <value name="X16"      value="4">
      <doc>Aniso X16.</doc>
    </value>
  </enum>

  <enum name="CLAMP">
    <doc>Sets the min/max clamp on LOD. 4.6 number format.</doc>
    <value name="MIN"             value="0">
      <doc>Represents 0.</doc>
    </value>
    <value name="MAX"             value="959">
      <doc>Represents 14.984375.</doc>
    </value>
    <value name="INTEGER_BITS"    value="4"/>
    <value name="FRACTIONAL_BITS" value="6"/>
  </enum>

  <enum name="CMP_MODE">
    <doc>Specifies comparison modes.</doc>
    <value name="NEVER"        value="0">
      <doc>Never, always return 0.</doc>
    </value>
    <value name="LESS"         value="1">
      <doc>Less than, Ref &lt; TexelData.</doc>
    </value>
    <value name="EQUAL"        value="2">
      <doc>Equal to, Ref = TexelData.</doc>
    </value>
    <value name="LESSEQUAL"    value="3">
      <doc>Less or equal to, Ref &lt;= TexelData.</doc>
    </value>
    <value name="GREATER"      value="4">
      <doc>Greater than, Ref &gt; TexelData.</doc>
    </value>
    <value name="NOTEQUAL"     value="5">
      <doc>Not equal to, Ref != TexelData.</doc>
    </value>
    <value name="GREATEREQUAL" value="6">
      <doc>Greater or equal to, Ref &gt;= TexelData.</doc>
    </value>
    <value name="ALWAYS"       value="7">
      <doc>Always, always return 1.</doc>
    </value>
  </enum>

  <enum name="COMPRESSION_LEVEL">
    <doc>Sets the lossy compression level for TFBC.</doc>
    <value name="LOSSLESS" value="0">
      <doc>Lossless compression.</doc>
    </value>
    <value name="LOSSY_75" value="1">
      <doc>Lossy compression down to 75% of the original size (lowest compression ratio).</doc>
    </value>
    <value name="LOSSY_50" value="2">
      <doc>Lossy compression down to 50% of the original size.</doc>
    </value>
    <value name="LOSSY_25" value="3">
      <doc>Lossy compression down to 25% of the original size (highest compression ratio).</doc>
    </value>
  </enum>

  <enum name="COMPRESSION_MODE">
    <doc>Sets the compression mode.</doc>
    <value name="NONE"                   value="0"/>
    <value name="TPU"                    value="1"/>
    <value name="FB_DIRECT_8X8"          value="2"/>
    <value name="FB_DIRECT_16X4"         value="3"/>
    <value name="FB_INDIRECT_1TILE_8X8"  value="4"/>
    <value name="FB_INDIRECT_1TILE_16X4" value="5"/>
    <value name="FB_INDIRECT_4TILE_8X8"  value="6"/>
    <value name="FB_INDIRECT_4TILE_16X4" value="7"/>
  </enum>

  <enum name="DADJUST">
    <doc>Sets the range of the DADJUST (aka LOD Bias). 5.8 number format.</doc>
    <value name="MIN_UINT"        value="0">
      <doc>Represents -15.996.</doc>
    </value>
    <value name="ZERO_UINT"       value="4095">
      <doc>Represents 0.0.</doc>
    </value>
    <value name="MAX_UINT"        value="8191">
      <doc>Represents 16.0.</doc>
    </value>
    <value name="INTEGER_BITS"    value="5"/>
    <value name="FRACTIONAL_BITS" value="8"/>
  </enum>

  <enum name="FILTER">
    <doc>Specifies texture filter.</doc>
    <value name="POINT"   value="0">
      <doc>Point filter.</doc>
    </value>
    <value name="LINEAR"  value="1">
      <doc>Bilinear filter.</doc>
    </value>
    <value name="BICUBIC" value="2">
      <doc>Bicubic filter.</doc>
    </value>
  </enum>

